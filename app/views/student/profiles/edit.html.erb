<div class="max-w-4xl mx-auto p-6 bg-white shadow-lg">
  <%= form_with(url: "#", method: :post, class: "grid grid-cols-[20%_1fr] grid-rows-[auto] gap-x-4 gap-y-6") do %>
    <!-- Profile Picture -->
    <div class="col-start-1 row-start-1 justify-self-center space-y-4">
      <%# image_tag("https://via.placeholder.com/160", size: "160x160") %>
      <label for="profile_picture" class="block font-medium">Upload Profile Picture</label>
      <%= file_field_tag :profile_picture, class: "w-full text-gray-700", disabled: true %>
    </div>

    <!-- Basic Info -->
    <div class="col-start-2 row-start-1">
      <div class="space-y-4">
        <label for="full_name" class="block font-medium">Name</label>
        <%= text_field_tag :full_name,nil, class: "w-full p-2 border border-gray-300", placeholder:"Enter your full name"%>
      </div>
    </div>

    <!-- Contact Info -->
    <div class="col-start-1 row-start-2">
      <div>
        <ul class="break-all space-y-4">
          <li>
            <label for="dob" class="block mb-2 font-medium">Date of Birth</label>
            <%= text_field_tag :dob,nil,id: "dob", class: "w-full p-2 border border-gray-300",placeholder:"10/11/2002" %>
          </li>   
          <li>
            <label for="telephone" class="block mb-2 font-medium">Telephone</label>
            <%= text_field_tag :telephone,nil, id: "telephone", class: "w-full p-2 border border-gray-300",placeholder: "+92 300 1234567", maxlength:13%>
          </li>
          <li>
            <fieldset class="mb-4">
              <legend class="block mb-2 font-medium">Email</legend>
              <div class="space-y-2">
                <%= text_field_tag :email,nil, id: "email", class: "w-full p-2 border border-gray-300",placeholder: "f123456@cfd.nu.edu.pk" %>
                <%= text_field_tag :email_personal,nil, id: "email_personal", class: "w-full p-2 border border-gray-300",placeholder: "personal@gmail.com" %>
              </div>
            </fieldset>
          </li>
          <li>
            <label for="address" class="block mb-2 font-medium">Address</label>
            <%= text_area_tag :address,nil, id: "address", class: "w-full p-2 border border-gray-300 resize-none",row:2,placeholder: "House #, Street #, Area ,City", maxlength:150%>
          </li>
          <li>
            <label for="linkedin" class="block mb-2 font-medium">LinkedIn</label>
            <%= text_field_tag :linkedin,nil, id: "linkedin", class: "w-full p-2 border border-gray-300",placeholder: "linkedin.com/in/subhan-attique-48a7a8274" %>
          </li>
          <li>
            <fieldset class="mb-4">
              <legend class="block mb-2 font-medium">Preference for Job</legend>
              <div class="space-y-2">
                <%= text_field_tag :city_1,nil, id: "city_1", class: "w-full p-2 border border-gray-300", placeholder: "City 1" %>
                <%= text_field_tag :city_2,nil, id: "city_2", class: "w-full p-2 border border-gray-300", placeholder: "City 2" %>
                <%= text_field_tag :city_3,nil, id: "city_3", class: "w-full p-2 border border-gray-300", placeholder: "City 3" %>
              </div>
            </fieldset>
          </li>
        </ul>
      </div>
    </div>

    <!-- Education, Projects, Activities, Skills, Interests -->
    <div class="col-start-2 row-start-2">
      <!-- Education -->
      <section class="mb-6">
        <h2 class="font-medium mb-2">Education</h2>
        <%= text_field_tag :institution_name,"National University of Computer and Emerging Sciences, Chiniot-Faisalabad Campus", class: "w-full p-2 border-none mb-2 text-gray-500 bg-gray-200", placeholder: "Institution Name", disabled: true%>
        <div class="flex flex-wrap gap-2 items-center">
          <%= text_field_tag :degree_title, nil, class: "w-1/4 p-2 border border-gray-300", placeholder: "Degree Title" %><span>-</span>
          <%= text_field_tag :degree_field, nil, class: "w-1/4 p-2 border border-gray-300", placeholder: "Field of Study" %><span>-</span> 
          <%= select_tag :degree_year, options_for_select((Date.today.year - 10)..Date.today.year, selected: Date.today.year), class: "w-1/4 p-2 border-none text-gray-600 bg-gray-200", disabled: true %>
        </div>
      </section>

      <!-- Projects -->
      <section class="mb-6">
        <h2 class="font-medium mb-2">Projects/Portfolio</h2>
        <%= text_field_tag :project_name, nil, class: "w-full p-2 border border-gray-300", placeholder: "Project Name" %>
        <%= text_area_tag :project_details, nil, class: "mt-2 w-full p-2 border border-gray-300 resize-none", rows: 4, placeholder: "Enter project details", maxlength: 500 %>
      </section>

      <!-- Activities, Honors & Awards -->
      <section class="mb-6">
        <h2 class="font-medium mb-2">Activities, Honors & Awards</h2>
        <div class="flex flex-wrap gap-2">
          <%= text_field_tag :project_name,nil, class: "flex-1 p-2 border border-gray-300", placeholder: "Activity 1 Title" %>
          <%= text_field_tag :project_name,nil, class: "flex-1 p-2 border border-gray-300", placeholder: "Institution/Organization" %>
        </div>
      </section>

      <!-- Skills -->
      <section class="mb-6">
        <h2 class="font-medium mb-2">Skills & Tools</h2>
        <%= text_field_tag :project_name, nil, class: "w-full p-2 border border-gray-300", placeholder: "Skill Title" %>
        <%= text_field_tag :skills, nil, class: "mt-2 w-full p-2 border border-gray-300 resize-none", placeholder: "Enter skills separated by comma (,)", maxlength: 150 %>
      </section>

      <!-- Interests -->
      <section>
        <h2 class="font-medium mb-2">Interests & Hobbies</h2>
        <%= text_field_tag :interests, nil, class: "w-full p-2 border border-gray-300 resize-none", placeholder: "Enter interests and hobbies separated by comma (,)", maxlength: 150 %>
      </section>
    </div>

    <!-- Submit Button -->
    <div class="col-span-2 text-right mt-6">
      <%= submit_tag "Save Changes", class: "px-6 py-2 bg-[#1499DC] text-white font-medium hover:bg-[#0d7bbd]" %>
    </div>
  <% end %>
</div>


