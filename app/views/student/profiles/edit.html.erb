<div class="max-w-4xl mx-auto p-6 bg-white shadow-lg">
  <%= form_with(model: @user, url: @form_action, method: :put, class: "grid grid-cols-[20%_1fr] grid-rows-[auto] gap-x-4 gap-y-6") do |f| %>

    <!-- Profile Picture -->
    <div class="col-start-1 row-start-1 space-y-4">
      <%= f.label :profile_picture, "Upload Profile Picture", class: "block font-medium" %>
      <%= f.file_field :profile_picture, class: "w-full text-gray-700" %>
    </div>

    <!-- Basic Info -->
    <div class="col-start-2 row-start-1">
      <div class="space-y-4">
        <%= f.label :full_name, "Name", class: "block font-medium" %>
        <%= f.text_field :full_name, class: "w-full p-2 border border-gray-300 rounded-md", 
                          placeholder:"Enter your full name", 
                          maxlength:50,
                          required: true, 
                          pattern: "[A-Za-z\s]+", 
                          title:"Only letters and spaces are allowed. Please remove numbers or special characters." %>
      </div>
    </div>

    <!-- Contact Info -->
    <div class="col-start-1 row-start-2">
      <div>
        <ul class="break-all space-y-4">
          <%= f.fields_for :student_profile, @user.student_profile do |sf| %>
            <li>
              <%= sf.label :date_of_birth, "Date of Birth", class: "block mb-2 font-medium" %>
              <%= sf.date_field  :date_of_birth, class: "w-full p-2 border border-gray-300 rounded-md" %>
            </li>   
            <li>
              <%= sf.label :phone_number, "Telephone", class: "block mb-2 font-medium" %>
              <%= sf.text_field :phone_number, class: "w-full p-2 border border-gray-300 rounded-md", 
                                placeholder: "+923001234567", 
                                maxlength:13,
                                required: true,
                                pattern: "\\+92\\d{10}", 
                                title: "Phone number must start with +92 and be followed by exactly 10 digits. Example: +923001234567. Do not include spaces, letters, or special characters." %>
            </li>
          <% end %>
          <li>
            <fieldset class="mb-4">
              <legend class="block mb-2 font-medium">Email</legend>
              <div class="space-y-2">
                <%= f.email_field :email, class: "w-full p-2 border-none text-gray-500 bg-gray-200 rounded-md", 
                                  placeholder: "f123456@cfd.nu.edu.pk",
                                  pattern: "f\\d{6}@cfd\\.nu\\.edu\\.pk",
                                  title: "Email must start with 'f', followed by exactly 6 digits, and end with '@cfd.nu.edu.pk'. Example: f123456@cfd.nu.edu.pk",
                                  disabled: true %>
                <%= f.fields_for :student_profile, @user.student_profile do |sf| %>
                  <%= sf.email_field :email_personal, class: "w-full p-2 border border-gray-300 rounded-md", 
                                    placeholder: "personal@gmail.com",
                                    maxlength: 100 %>
                <% end %>
              </div>
            </fieldset>
          </li>
          <%= f.fields_for :student_profile, @user.student_profile do |sf| %>
            <li>
              <%= sf.label :address, "Address", class: "block mb-2 font-medium" %>
              <%= sf.text_area :address, class: "w-full p-2 border border-gray-300 resize-none rounded-md capitalize", row:2, placeholder: "House #, Street #, Area ,City", maxlength:100%>
            </li>
            <li>
              <%= sf.label :linkedin_url, "LinkedIn", class: "block mb-2 font-medium" %>
              <%= sf.text_field :linkedin_url, class: "w-full p-2 border border-gray-300 rounded-md", 
                                placeholder: "https://linkedin.com/in/your-profile",
                                pattern: 'https?:\/\/(www\.)?linkedin\.com\/.*', 
                                title: "Enter a valid LinkedIn URL (e.g., https://linkedin.com/in/your-profile)",
                                required: true %>
            </li>
          <% end %>
          <li>
            <fieldset class="mb-4">
              <legend class="block mb-2 font-medium">Preference for Job</legend>
              <div class="space-y-2">
                <%= f.fields_for :student_profile, @user.student_profile do |sf| %>
                  <% 3.times do |i| %>
                    <%= sf.fields_for :location_preferences, @user.student_profile.location_preferences[i] || @user.student_profile.location_preferences.build do |lp_form| %>
                      <%= lp_form.text_field :location, class: "w-full p-2 border border-gray-300 rounded-md capitalize", 
                                              placeholder: "City #{i + 1}", 
                                              maxlength: 20,
                                              pattern: "[A-Za-z\s]+", 
                                              title:"Only letters and spaces are allowed. Please remove numbers or special characters." %>
                    <% end %>
                  <% end %>  
                <% end %>
              </div>
            </fieldset>
          </li>
        </ul>
      </div>
    </div>

    <!-- Education, Projects, Activities, Skills, Interests -->
    <div class="col-start-2 row-start-2">
      <!-- Education -->
      <section class="mb-6">
        <h2 class="font-medium mb-2">Education</h2>
        <%= f.fields_for :student_profile, @user.student_profile do |sf| %>
          <div class="space-y-2">
            <%= sf.fields_for :educations, @user.student_profile.educations[0] || @user.student_profile.educations.build do |ef| %>
              <div>
                <%= ef.text_field :institution_name, value: "National University of Computer and Emerging Sciences, Chiniot-Faisalabad Campus" , class: "w-full p-2 border-none mb-2 text-gray-500 bg-gray-200 rounded-md", 
                                  placeholder: "Institution Name", disabled: true,
                                  pattern: "[A-Za-z\s]+", 
                                  title:"Only letters and spaces are allowed. Please remove numbers or special characters.",
                                  maxlength: 80 %>
                <div class="flex flex-wrap gap-2 items-center">
                  <%= ef.select :degree, options_for_select([
                    "BS (Computer Science)",
                    "BS (Software Engineering)",
                    "Bachelor of Business Administration",
                    "BS (Electrical Engineering)"
                  ], ef.object.degree), { prompt: "Select Degree" }, { class: "w-2/5 p-2 border border-gray-300 rounded-md", required: true } %>
                  <span>-</span>
                  <%= ef.select :graduation_year, options_for_select((Date.today.year - 10..Date.today.year).to_a.reverse, Date.today.year), {}, { disabled: true, class: "w-1/4 p-2 border-none text-gray-600 bg-gray-200 rounded-md" } %>
                </div>
              </div>
            <% end %>
            <%= sf.fields_for :educations, @user.student_profile.educations[1] || @user.student_profile.educations.build do |ef| %>
              <div>
                <%= ef.text_field :institution_name, class: "w-full p-2 mb-2 border border-gray-300 rounded-md capitalize",
                                  placeholder: "Intermediate College",
                                  pattern: "[A-Za-z\s]+", 
                                  title:"Only letters and spaces are allowed. Please remove numbers or special characters.",
                                  maxlength: 80,
                                  required: true %>
                <div class="flex flex-wrap gap-2 items-center">
                  <%= ef.select :degree, options_for_select([
                    "F.Sc - Pre Engineering",
                    "F.Sc - Pre Medical",
                    "A - Levels",
                    "A Levels - Computer Science",
                    "A Levels - Pre Engineering",
                    "A Levels - Pre Medical",
                    "ICS",
                    "I.Com"
                  ], ef.object.degree), { prompt: "Select Degree" }, { class: "w-2/5 p-2 border border-gray-300 rounded-md", required: true } %>
                  <span>-</span>
                  <%= ef.select :graduation_year, options_for_select((Date.today.year - 10..Date.today.year).to_a.reverse, @user.student_profile.educations[1]&.graduation_year), {}, { class: "w-1/4 p-2 border border-gray-300 rounded-md" } %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </section>

      <!-- Projects -->
      <section class="mb-6">
        <h2 class="font-medium mb-2">Projects/Portfolio</h2>
        <%= f.fields_for :student_profile, @user.student_profile do |sf| %>
            <!-- Requirement message -->
            <p class="text-sm text-red-600 mb-2">
              * A minimum of 3 projects are required. The first must be your Final Year Project. Please use the full character space available for titles and descriptions, starting each word with a capital letter for title only.
            </p>
            <% 5.times do |i| %>
              <%= sf.fields_for :projects, @user.student_profile.projects[i] || @user.student_profile.projects.build do |pf| %>
                  <% label_text = (i == 0) ? "Final Year Project Name" : "Project Name" %>
                  <% required_field = i < 3 %>
                  <% description_maxlength = case i
                               when 0 then 450
                               when 1, 2 then 250
                               else 150
                               end %>
                  <%= pf.text_field :project_name, class: "w-full p-2 border border-gray-300 rounded-md capitalize", 
                                    placeholder: label_text, 
                                    maxlength: 80,
                                    required: required_field %>
                  <%= pf.text_area :description, class: "mt-2 w-full p-2 border border-gray-300 resize-none rounded-md", rows: 4, 
                                    placeholder: "Enter project details", 
                                    maxlength: description_maxlength,
                                    required: required_field %>
              <% end %>
            <% end %>
        <% end %>
      </section>

      <!-- Activities, Honors & Awards -->
      <section class="mb-6">
        <h2 class="font-medium mb-2">Activities, Honors & Awards</h2>
          <%= f.fields_for :student_profile, @user.student_profile do |sf| %>
            <!-- Requirement message -->
            <p class="text-sm text-red-600 mb-2">
              * You may add 1 to 3 entries including achievements, awards, internships, TA roles, Dean's List, event management, freelancing, or society positions. Each word in titles and organizations should start with a capital letter.
            </p>
           
            <% 3.times do |i| %>
              <%= sf.fields_for :activities_honors, @user.student_profile.activities_honors[i] || @user.student_profile.activities_honors.build do |ahf| %>
                  <div class="flex flex-wrap gap-2 mb-2">

                    <%= ahf.text_field :title, class: "flex-1 p-2 border border-gray-300 rounded-md capitalize", 
                                        placeholder: "Achievement", 
                                        size: 20, 
                                        maxlength: 30,
                                        required: i == 0 %>
                    <%= ahf.text_field :organization, class: "flex-1 p-2 border border-gray-300 rounded-md capitalize", 
                                        placeholder: "Associated Organization", 
                                        size: 20, 
                                        maxlength: 30,
                                        required: i == 0 %>
                  </div>
              <% end %>
            <% end %>
          <% end %>
       
      </section>

      <!-- Skills -->
      <section class="mb-6">
        <h2 class="font-medium mb-2">Skills & Tools</h2>
        <%= f.fields_for :student_profile, @user.student_profile do |sf| %>
            <!-- Requirement message -->
            <p class="text-sm text-red-600 mb-2">
              * You may add 1 to 2 skill categories (e.g. Programming Languages, Tools). Each should list skills separated by commas. The first entry is required.
            </p>
            <% 2.times do |i| %>
              <%= sf.fields_for :skills, @user.student_profile.skills[i] || @user.student_profile.skills.build do |skf| %>
                  <div class="mb-2">
                    <% title_placeholder = i == 0 ? "Programming Languages" : "Tools" %>
                    <% skill_list_placeholder = i == 0 ? "Java, Python, C++, SQL" : "VS Code, PyCharm, MySQL" %>

                    <%= skf.text_field :title, class: "w-full p-2 border border-gray-300 rounded-md capitalize", 
                                        placeholder: title_placeholder,
                                        maxlength: 50,
                                        required: i == 0 %>
                    <%= skf.text_field :skill_list, class: "mt-2 w-full p-2 border border-gray-300 resize-none rounded-md capitalize", 
                                        placeholder: skill_list_placeholder, 
                                        maxlength: 185,
                                        required: i == 0 %> 
                  </div>
              <% end %>
            <% end %>
        <% end %>
      </section>

      <!-- Interests -->
      <section>
        <h2 class="font-medium mb-2">Interests & Hobbies</h2>
        <%= f.fields_for :student_profile, @user.student_profile do |sf| %>
            <%= sf.fields_for :interests, @user.student_profile.interests.presence || @user.student_profile.interests.build do |inf| %>
              <%= inf.text_field :interest_list, class: "w-full p-2 border border-gray-300 resize-none rounded-md capitalize",
                                 placeholder: "Travelling, Watch Documentaries, E-Gaming, Swimming", 
                                 maxlength: 80 %>
            <% end %>
        <% end %>
      </section>
    </div>

    <!-- Submit Button -->
    <div class="col-span-2 text-right mt-6">
      <%= f.submit "Save Changes", class: "px-6 py-2 bg-[#1499DC] text-white font-medium hover:bg-[#0d7bbd] rounded-md" %>
    </div>
  <% end %>
</div>


