<div class="min-h-[50vh] grid place-content-center text-[#333333] text-center">

    <h1 class="text-3xl font-bold mb-4">Welcome to Your Dashboard</h1>

    <div class="space-y-4 text-base">
        <p class="">
            Our platform is currently under development. In the meantime, you can get started by updating your profile and submitting your digital resume.
        </p>
        <p class="">
            This will help recruiters and career officers learn more about you.
        </p>
    </div>      

    <%= link_to @edit_profile_path, class: 'mt-6 justify-self-center text-center py-2 px-4 bg-[#1499DC] hover:bg-[#0d7bbd] rounded-md' do %>
