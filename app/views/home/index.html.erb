<h1 style="text-align: center; font-size: 2.5em; color: #2c3e50; font-family: Arial, sans-serif;">Welcome to Our Student Recruitment & Career Services Platform</h1>

<% if flash[:notice] %>
  <p style="color: green; text-align: center; font-size: 1.1em; font-family: Arial, sans-serif;"><%= flash[:notice] %></p>
<% end %>

<% if user_signed_in? %>
  <p style="text-align: center; font-size: 1.2em; color: #34495e;">Welcome, <strong><%= current_user.email %></strong>!</p>
  <div style="text-align: center; margin-top: 20px;">
    <div style="margin-bottom: 10px;">
      <%= link_to 'Go to Dashboard', home_dashboard_path, class: 'btn btn-primary' %>
    </div>
    <div>
      <%= link_to 'Logout', destroy_user_session_path, method: :delete, data: { turbo_method: :delete }, class: 'btn btn-danger' %>
    </div>
  </div>
<% else %>
  <div style="text-align: center; margin-top: 20px;">
    <div style="margin-bottom: 10px;">
      <%= link_to 'Login', new_user_session_path, class: 'btn btn-secondary' %>
    </div>
    <div>
      <%= link_to 'Sign Up', new_user_registration_path, class: 'btn btn-success' %>
    </div>
  </div>
<% end %>
