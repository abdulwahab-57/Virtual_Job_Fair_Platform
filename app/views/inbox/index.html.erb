<div class="flex h-full">
  <!-- Conversations List (Left Panel) -->
  <div class="w-1/3 bg-white rounded-lg shadow-sm mr-4 p-4 overflow-y-auto max-h-[80vh]">
    <div class="mb-4">
      <h2 class="text-lg font-semibold text-gray-800 mb-3">Recent Conversations</h2>
      
      <% if @conversations.any? %>
        <div class="space-y-3">
          <% @conversations.each do |conversation| %>
            <% other_user = conversation.other_participant(current_user) %>
            <% most_recent = conversation.most_recent_message %>
            <% has_unread = conversation.unread_messages_for?(current_user) %>
            <% is_selected = @selected_conversation&.id == conversation.id %>
            
            <%= link_to inbox_path(conversation_id: conversation.id), class: "flex items-start p-3 rounded-lg transition-colors #{is_selected ? 'bg-blue-100' : (has_unread ? 'bg-blue-50' : 'bg-gray-50 hover:bg-gray-100')}" do %>
              <div class="flex-1 min-w-0">
                <p class="font-medium <%= has_unread ? 'text-blue-700' : 'text-gray-800' %>">
                  <%= other_user.full_name %>
                  <span class="text-xs px-2 py-1 ml-2 rounded-full <%= has_unread ? 'bg-blue-100 text-blue-700' : 'bg-gray-200 text-gray-600' %>">
                    <%= other_user.user_type.titleize %>
                  </span>
                  <% if has_unread %>
                    <span class="inline-flex items-center justify-center ml-2 w-5 h-5 text-xs font-medium bg-blue-600 text-white rounded-full">
                      <%= conversation.unread_messages_count_for(current_user) %>
                    </span>
                  <% end %>
                </p>
                
                <% if most_recent %>
                  <p class="text-sm truncate <%= has_unread ? 'text-blue-600' : 'text-gray-500' %>">
                    <%= most_recent.body.truncate(50) %>
                  </p>
                  <p class="text-xs <%= has_unread ? 'text-blue-500' : 'text-gray-400' %>">
                    <%= time_ago_in_words(most_recent.created_at) %> ago
                  </p>
                <% else %>
                  <p class="text-sm text-gray-500">No messages yet</p>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-8 px-4 bg-gray-50 rounded-lg">
          <p class="text-gray-500">No conversations yet.</p>
          <p class="text-sm text-gray-400 mt-1">Start a new conversation from the list below.</p>
        </div>
      <% end %>
    </div>
    
    <!-- Start New Conversation Section -->
    <div class="mt-8">
      <h2 class="text-lg font-semibold text-gray-800 mb-3">Start a New Conversation</h2>
      
      <% if @users.any? %>
        <div class="space-y-2">
          <% @users.group_by(&:user_type).each do |user_type, users| %>
            <h3 class="text-sm font-medium text-gray-600 mt-4 mb-2 capitalize">
              <%= user_type.pluralize %>
            </h3>
            
            <% users.each do |user| %>
              <div class="flex items-center justify-between p-3 bg-gray-50 hover:bg-gray-100 rounded-lg transition-colors">
                <div>
                  <p class="font-medium text-gray-800">
                    <%= user.full_name %>
                  </p>
                  <% case user.user_type %>
                  <% when "student" %>
                    <p class="text-xs text-gray-500">
                      <%= user.student_profile&.educations&.first&.institution_name || "Student" %>
                    </p>
                  <% when "recruiter" %>
                    <p class="text-xs text-gray-500">
                      <%= user.recruiter_profile&.company_name || "Recruiter" %>
                    </p>
                  <% when "career_officer" %>
                    <p class="text-xs text-gray-500">
                      <%= user.career_officer_profile&.designation || "Career Officer" %>
                    </p>
                  <% end %>
                </div>
                
                <%= button_to conversations_path(recipient_id: user.id), method: :post, class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium py-1 px-3 rounded-md transition-colors" do %>
                  Message
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-8 px-4 bg-gray-50 rounded-lg">
          <p class="text-gray-500">No users available to message.</p>
        </div>
      <% end %>
    </div>
  </div>
  
  <!-- Right Panel - Either Conversation or Welcome Message -->
  <div class="w-2/3 bg-white rounded-lg shadow-sm p-6 flex flex-col">
    <% if @selected_conversation %>
      <!-- Selected Conversation View -->
      <div class="flex-1 flex flex-col h-full">
        <div class="flex items-center mb-6">
          <div class="flex-1">
            <% other_user = @selected_conversation.other_participant(current_user) %>
            <h2 class="text-xl font-semibold">
              <span class="text-gray-800">
                <%= other_user.full_name %>
              </span>
              <% other_user_type = other_user.user_type %>
              <span class="ml-2 px-3 py-1 text-sm rounded-full 
                <%= other_user_type == 'student' ? 'text-blue-600 bg-blue-100' : 
                  (other_user_type == 'recruiter' ? 'text-indigo-600 bg-indigo-100' : 'text-purple-600 bg-purple-100') %>">
                <%= other_user_type.titleize %>
              </span>
            </h2>
            <p class="text-sm text-gray-500">
              <% case other_user.user_type %>
              <% when "student" %>
                <%= other_user.student_profile&.educations&.first&.institution_name || "Student" %>
              <% when "recruiter" %>
                <%= other_user.recruiter_profile&.company_name || "Recruiter" %>
              <% when "career_officer" %>
                <%= other_user.career_officer_profile&.designation || "Career Officer" %>
              <% end %>
            </p>
          </div>
          
          <%= link_to inbox_path, class: "flex items-center text-gray-500 hover:text-gray-700 transition-colors text-sm" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Inbox
          <% end %>
        </div>
        
        <!-- Messages Container -->
        <div id="messages-container" class="flex-1 overflow-y-auto mb-4 space-y-4 px-2" style="max-height: 60vh;">
          <% if @selected_conversation.messages.any? %>
            <% @selected_conversation.messages.order(created_at: :asc).each do |message| %>
              <% is_current_user = message.user == current_user %>
              <div class="flex <%= is_current_user ? 'justify-end' : 'justify-start' %> mb-3">
                <div class="max-w-[75%] <%= is_current_user ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-800' %> rounded-lg px-4 py-3 shadow-sm">
                  <p class="<%= is_current_user ? 'text-white' : 'text-gray-900' %> text-sm">
                    <%= message.body %>
                  </p>
                  <div class="flex justify-between items-center mt-1">
                    <span class="<%= is_current_user ? 'text-blue-200' : 'text-gray-500' %> text-xs">
                      <%= message.user.full_name %>
                    </span>
                    <span class="<%= is_current_user ? 'text-blue-200' : 'text-gray-500' %> text-xs">
                      <%= message.created_at.strftime("%I:%M %p • %b %d") %>
                    </span>
                  </div>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="text-center py-12">
              <p class="text-gray-500">No messages yet. Send the first message!</p>
            </div>
          <% end %>
        </div>
        
        <!-- Message Form -->
        <div class="mt-auto border-t pt-4">
          <%= form_with(model: [@selected_conversation, @message], local: true, class: "flex") do |f| %>
            <div class="flex-1 mr-2">
              <%= f.text_area :body, rows: 2, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 placeholder-gray-400 resize-none", placeholder: "Type your message...", required: true %>
            </div>
            
            <%= f.submit "Send", class: "bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-6 rounded-lg transition-colors self-end" %>
          <% end %>
        </div>
      </div>
    <% else %>
      <!-- Welcome Message -->
      <div class="flex-1 flex flex-col items-center justify-center text-center">
        <div class="max-w-md">
          <div class="mb-6 text-blue-600">
            <!-- Chat Icon -->
            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
            </svg>
          </div>
          
          <h2 class="text-2xl font-bold text-gray-800 mb-3">Welcome to Your Inbox</h2>
          
          <p class="text-gray-600 mb-6">
            Connect with students, recruiters, and career officers through direct messaging.
            Select a conversation from the left or start a new one.
          </p>
          
          <div class="grid grid-cols-3 gap-4 text-center mt-2">
            <div class="p-3 bg-blue-50 rounded-lg">
              <p class="text-sm font-medium text-blue-700">Chat with Students</p>
              <p class="text-xs text-blue-600 mt-1">Discuss opportunities</p>
            </div>
            
            <div class="p-3 bg-indigo-50 rounded-lg">
              <p class="text-sm font-medium text-indigo-700">Connect with Recruiters</p>
              <p class="text-xs text-indigo-600 mt-1">Explore job openings</p>
            </div>
            
            <div class="p-3 bg-purple-50 rounded-lg">
              <p class="text-sm font-medium text-purple-700">Contact Career Officers</p>
              <p class="text-xs text-purple-600 mt-1">Get career guidance</p>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<% if @selected_conversation&.messages&.any? %>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const messagesContainer = document.getElementById('messages-container');
      if (messagesContainer) {
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
      }
    });
  </script>
<% end %> 