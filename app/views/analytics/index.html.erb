<div class="bg-white p-6 rounded-lg shadow-md">
  <h1 class="text-2xl font-bold mb-6"><%= current_user.student? ? "Report Dashboard" : "Analytics Dashboard" %></h1>
  
  <% if current_user.student? %>
    <%= render 'analytics/student_dashboard', student: current_user %>
  <% elsif current_user.recruiter? %>
    <%= render 'analytics/recruiter_dashboard', recruiter: current_user %>
  <% elsif current_user.career_officer? %>
    <%= render 'analytics/career_officer_dashboard' %>
  <% else %>
    <p class="text-gray-500">No analytics available for your user type.</p>
  <% end %>
  
  <div class="mt-8 text-center">
    <% if current_user.student? %>
      <%= link_to enhanced_analytics_student_dashboard_path(current_user), class: "analytics-btn" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z" clip-rule="evenodd" />
        </svg>
        View Enhanced Report
      <% end %>
    <% elsif current_user.recruiter? %>
      <%= link_to enhanced_analytics_recruiter_dashboard_path(current_user), class: "analytics-btn" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z" clip-rule="evenodd" />
        </svg>
        View Enhanced Analytics
      <% end %>
    <% elsif current_user.career_officer? %>
      <%= link_to enhanced_analytics_career_officer_dashboard_path, class: "analytics-btn" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z" clip-rule="evenodd" />
        </svg>
        View Enhanced Analytics
      <% end %>
    <% end %>
  </div>
</div> 