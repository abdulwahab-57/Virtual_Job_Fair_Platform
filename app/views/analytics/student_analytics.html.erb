<div class="bg-white p-6 rounded-lg shadow-md">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold">Student Analytics: <%= @student.full_name %></h1>
    <% if current_user.career_officer? %>
      <%= link_to "Back to Student Profiles", career_officer_student_profiles_path, class: "text-blue-600 hover:underline" %>
    <% end %>
  </div>
  
  <%= render 'analytics/student_dashboard', student: @student %>
</div> 