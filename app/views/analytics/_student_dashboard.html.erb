<div class="space-y-6">
  <div class="analytics-card">
    <div class="analytics-card-header">
      <h2 class="text-lg font-semibold text-blue-700">Profile Completion</h2>
    </div>
    <div class="analytics-card-body">
      <div class="progress-bar-container">
        <div class="progress-bar-fill blue" style="width: <%= calculate_profile_completion(student) %>%"></div>
      </div>
      <p class="mt-2 text-sm text-gray-600"><%= calculate_profile_completion(student) %>% complete</p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="analytics-card">
      <div class="analytics-card-header">
        <h2 class="text-lg font-semibold text-blue-700">Skills</h2>
      </div>
      <div class="analytics-card-body">
        <div class="text-3xl font-bold text-blue-600"><%= student.student_profile&.skills&.count || 0 %></div>
        <p class="text-sm text-gray-600">Total skills listed</p>
      </div>
    </div>

    <div class="analytics-card">
      <div class="analytics-card-header">
        <h2 class="text-lg font-semibold text-blue-700">Education</h2>
      </div>
      <div class="analytics-card-body">
        <div class="text-3xl font-bold text-blue-600"><%= student.student_profile&.educations&.count || 0 %></div>
        <p class="text-sm text-gray-600">Education entries</p>
      </div>
    </div>
  </div>

  <% if student.student_profile&.educations&.any? %>
    <div class="analytics-card">
      <div class="analytics-card-header">
        <h2 class="text-lg font-semibold text-blue-700">Education Timeline</h2>
      </div>
      <div class="analytics-card-body">
        <div class="space-y-3">
          <% student.student_profile.educations.order(graduation_year: :desc).each do |education| %>
            <div class="flex items-start">
              <div class="min-w-20 font-medium"><%= education.graduation_year %></div>
              <div>
                <div class="font-medium"><%= education.degree %></div>
                <div class="text-sm text-gray-600"><%= education.institution_name %></div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
  
  <div class="mt-4 text-center">
    <%= link_to enhanced_analytics_student_dashboard_path(student), class: "analytics-btn" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z" clip-rule="evenodd" />
      </svg>
      View Enhanced Analytics
    <% end %>
  </div>
</div> 