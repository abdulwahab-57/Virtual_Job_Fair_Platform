<div class="space-y-6">
  <div class="analytics-card">
    <div class="analytics-card-header">
      <h2 class="text-lg font-semibold text-blue-700">Profile Completion</h2>
    </div>
    <div class="analytics-card-body">
      <div class="progress-bar-container">
        <div class="progress-bar-fill blue" style="width: <%= calculate_profile_completion(recruiter) %>%"></div>
      </div>
      <p class="mt-2 text-sm text-gray-600"><%= calculate_profile_completion(recruiter) %>% complete</p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="analytics-card">
      <div class="analytics-card-header">
        <h2 class="text-lg font-semibold text-blue-700">Company Information</h2>
      </div>
      <div class="analytics-card-body">
        <div class="space-y-2">
          <div class="flex justify-between">
            <span class="text-gray-600">Company Name:</span>
            <span><%= recruiter.recruiter_profile&.company_name || "Not provided" %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-600">Industry:</span>
            <span><%= recruiter.recruiter_profile&.industry || "Not provided" %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-600">Office Location:</span>
            <span><%= recruiter.recruiter_profile&.office_location || "Not provided" %></span>
          </div>
        </div>
      </div>
    </div>

    <div class="analytics-card">
      <div class="analytics-card-header">
        <h2 class="text-lg font-semibold text-blue-700">Potential Student Matches</h2>
      </div>
      <div class="analytics-card-body">
        <div class="text-3xl font-bold text-blue-600"><%= User.where(user_type: "student").count %></div>
        <p class="text-sm text-gray-600">Total student profiles</p>
      </div>
    </div>
  </div>
  
  <div class="mt-4 text-center">
    <%= link_to enhanced_analytics_recruiter_dashboard_path(recruiter), class: "analytics-btn" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z" clip-rule="evenodd" />
      </svg>
      View Enhanced Analytics
    <% end %>
  </div>
</div> 