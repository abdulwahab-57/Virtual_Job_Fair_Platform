<!DOCTYPE html>
<html>

<head>
    <%= render "shared/head" %>
</head>

<body class="bg-gray-100 font-roboto">
    <div class="flex min-h-screen">
        <!-- Sidebar -->
        <%= render SideBarComponent.new(tabs: @sidebar_tabs, home_path: @home_path) %>

            <!-- Main Content Area -->
            <div class="flex-1 flex flex-col">
                <!-- Navbar -->
                <%= render "shared/private_navbar" %>

                    <!-- Main Content -->
                    <div class="bg-grey-50 p-8">
                        <%= yield %>
                    </div>
            </div>

    </div>
</body>

</html>