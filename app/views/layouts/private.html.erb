<!DOCTYPE html>
<html>

<head>
    <%= render "shared/head" %>
</head>

<body class="bg-gray-100 font-roboto">
    <div class="flex min-h-screen">
        <!-- Sidebar -->
        <%= render SideBarComponent.new(tabs: @sidebar_tabs, home_path: @home_path) %>

        <!-- Main Content Area -->
        <div class="flex-1 flex flex-col">
            <!-- Navbar -->
            <%= render "shared/private_navbar", header_text: @header_text %>

            <!-- Main Content -->
            <div class="p-8">
                <!-- Flash Messages -->
                <% if notice %>
                    <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-4 rounded shadow" role="alert">
                        <p><%= notice %></p>
                    </div>
                <% end %>
                
                <% if alert %>
                    <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-4 rounded shadow" role="alert">
                        <p><%= alert %></p>
                    </div>
                <% end %>
                
                <%= yield %>
            </div>
        </div>
    </div>
</body>

</html>