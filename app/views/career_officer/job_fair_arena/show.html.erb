<div class="bg-white rounded-lg shadow-lg p-6">
    <% if @meeting_number.present? %>
          <div 
            id="meetingSDKElement" 
            class="aspect-w-16 aspect-h-9 rounded-lg bg-gray-100"
            data-controller="zoom-meeting"
            data-zoom-meeting-target="meetingSDKElement"
            data-zoom-meeting-sdk-key-value="<%= @zoom_sdk_key %>"
            data-zoom-meeting-signature-value="<%= @zoom_signature %>"
            data-zoom-meeting-meeting-number-value="<%= @meeting_number %>"
            data-zoom-meeting-meeting-password-value="<%= @zoom_password %>"
            data-zoom-meeting-user-name-value="<%= current_user.full_name %>"
            data-zoom-meeting-role-value="0"
          >
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="text-center">
                <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-indigo-500 mb-4"></div>
                <p class="text-gray-600">Initializing Zoom Meeting...</p>
              </div>
            </div>
          </div>
          
    <% else %>
          <div class="flex flex-col items-center justify-center h-96 p-8 text-center">
            <svg class="w-16 h-16 text-red-500 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <h3 class="text-lg font-medium text-gray-900 mb-2">Failed to join the meeting</h3>
            <p class="text-gray-600 mb-4">Could not initialize the Zoom meeting. Missing required parameters.</p>
            <div class="space-y-4">
              <p class="text-gray-700">You can still join this meeting using the Zoom app:</p>
              <a href="<%= "" %>" target="_blank" class="inline-block bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded">
                Join via Zoom App
              </a>
            </div>
          </div>
    <% end %>
</div>