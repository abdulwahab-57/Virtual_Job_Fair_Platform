<!-- Add meta tag for mobile web app capability -->
<% content_for :head do %>
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
<% end %>

<div class="container mx-auto px-4 py-8">
  <div class="mb-6 flex justify-between items-center">
    <h1 class="text-2xl font-bold text-gray-800"><%= @meeting.title %> - Virtual Booth</h1>
    <div>
      <%= link_to "Back to Job Fair Arena", career_officer_job_fair_arena_index_path, class: "text-gray-600 hover:text-gray-800" %>
    </div>
  </div>

  <% if Rails.env.development? %>
    <div class="mb-6 bg-gray-100 p-4 rounded-lg">
      <h2 class="text-lg font-semibold mb-2">Debug Information</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <p><strong>Meeting Number:</strong> <%= @meeting_number %></p>
          <p><strong>Meeting Password:</strong> <%= @meeting_password %></p>
          <p><strong>SDK Version:</strong> NPM Package</p>
          <p><strong>Role:</strong> 0 (attendee)</p>
        </div>
        <div>
          <p><strong>Zoom URL:</strong> <%= @meeting.zoom_meeting_url %></p>
          <p><strong>Meeting Status:</strong> <%= @meeting.status %></p>
          <p><strong>Is Active:</strong> <%= @meeting.active? ? 'Yes' : 'No' %></p>
          <p><strong>Client ID:</strong> <%= ENV["ZOOM_CLIENT_ID"][0..5] %>...</p>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="md:col-span-2">
      <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
        <h2 class="text-xl font-semibold mb-4">Meeting Details</h2>
        
        <div class="mb-4">
          <p class="text-gray-700"><strong>Description:</strong></p>
          <p class="mt-1"><%= @meeting.description.present? ? @meeting.description : "No description provided." %></p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
          <div>
            <p class="text-gray-700"><strong>Start Time:</strong></p>
            <p class="mt-1"><%= @meeting.start_time.strftime("%b %d, %Y %I:%M %p") %></p>
          </div>
          <div>
            <p class="text-gray-700"><strong>End Time:</strong></p>
            <p class="mt-1"><%= @meeting.end_time.strftime("%b %d, %Y %I:%M %p") %></p>
          </div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
          <div>
            <p class="text-gray-700"><strong>Status:</strong></p>
            <p class="mt-1">
              <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                Active
              </span>
            </p>
          </div>
          <div>
            <p class="text-gray-700"><strong>Host:</strong></p>
            <p class="mt-1"><%= @meeting.host&.full_name || "Unknown" %></p>
          </div>
        </div>
        
        <div class="mb-4">
          <p class="text-gray-700"><strong>Time Remaining:</strong></p>
          <p class="mt-1" id="time-remaining">
            <%= distance_of_time_in_words(Time.current, @meeting.end_time) %>
          </p>
        </div>
      </div>
      
      <div class="bg-white rounded-lg shadow-lg p-6">
        <h2 class="text-xl font-semibold mb-4">Virtual Booth</h2>
        <% if @meeting_number.present? %>
          <div 
            id="meetingSDKElement" 
            class="aspect-w-16 aspect-h-9 rounded-lg bg-gray-100"
            data-controller="zoom-meeting"
            data-zoom-meeting-target="meetingSDKElement"
            data-zoom-meeting-sdk-key-value="<%= ENV['ZOOM_CLIENT_ID'] %>"
            data-zoom-meeting-signature-value="<%= @zoom_signature %>"
            data-zoom-meeting-meeting-number-value="<%= @meeting_number %>"
            data-zoom-meeting-password-value="<%= @meeting_password %>"
            data-zoom-meeting-user-name-value="<%= current_user.full_name %>"
            data-zoom-meeting-role-value="0"
          >
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="text-center">
                <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-indigo-500 mb-4"></div>
                <p class="text-gray-600">Initializing Zoom Meeting...</p>
              </div>
            </div>
          </div>
        <% else %>
          <div class="flex flex-col items-center justify-center h-96 p-8 text-center">
            <svg class="w-16 h-16 text-red-500 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <h3 class="text-lg font-medium text-gray-900 mb-2">Failed to join the meeting</h3>
            <p class="text-gray-600 mb-4">Could not initialize the Zoom meeting. Missing required parameters.</p>
            <div class="space-y-4">
              <p class="text-gray-700">You can still join this meeting using the Zoom app:</p>
              <a href="<%= @meeting.zoom_meeting_url %>" target="_blank" class="inline-block bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded">
                Join via Zoom App
              </a>
            </div>
          </div>
        <% end %>
      </div>
    </div>
    
    <div>
      <div class="bg-white rounded-lg shadow-lg p-6">
        <h2 class="text-xl font-semibold mb-4">Participants</h2>
        
        <% if @meeting.users.empty? %>
          <p class="text-gray-600">No participants in this meeting.</p>
        <% else %>
          <div class="mb-4">
            <h3 class="font-medium text-gray-700 mb-2">Students</h3>
            <ul class="divide-y divide-gray-200">
              <% @meeting.student_participants.each do |student| %>
                <li class="py-2 flex items-center">
                  <div class="h-8 w-8 rounded-full bg-blue-100 text-blue-500 flex items-center justify-center mr-3">
                    <%= student.full_name[0].upcase %>
                  </div>
                  <span><%= student.full_name %></span>
                </li>
              <% end %>
              <% if @meeting.student_participants.empty? %>
                <li class="py-2 text-gray-500 italic">No students</li>
              <% end %>
            </ul>
          </div>
          
          <div class="mb-4">
            <h3 class="font-medium text-gray-700 mb-2">Recruiters</h3>
            <ul class="divide-y divide-gray-200">
              <% @meeting.recruiter_participants.each do |recruiter| %>
                <li class="py-2 flex items-center">
                  <div class="h-8 w-8 rounded-full bg-green-100 text-green-500 flex items-center justify-center mr-3">
                    <%= recruiter.full_name[0].upcase %>
                  </div>
                  <span><%= recruiter.full_name %> (<%= recruiter.recruiter_profile.company_name %>)</span>
                </li>
              <% end %>
              <% if @meeting.recruiter_participants.empty? %>
                <li class="py-2 text-gray-500 italic">No recruiters</li>
              <% end %>
            </ul>
          </div>
          
          <div>
            <h3 class="font-medium text-gray-700 mb-2">Career Officers</h3>
            <ul class="divide-y divide-gray-200">
              <% @meeting.career_officer_participants.each do |officer| %>
                <li class="py-2 flex items-center">
                  <div class="h-8 w-8 rounded-full bg-purple-100 text-purple-500 flex items-center justify-center mr-3">
                    <%= officer.full_name[0].upcase %>
                  </div>
                  <span><%= officer.full_name %></span>
                </li>
              <% end %>
              <% if @meeting.career_officer_participants.empty? %>
                <li class="py-2 text-gray-500 italic">No career officers</li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
  // Update time remaining every minute
  document.addEventListener('DOMContentLoaded', function() {
    setInterval(function() {
      const endTime = new Date('<%= @meeting.end_time.iso8601 %>');
      const now = new Date();
      const diff = endTime - now;
      
      if (diff <= 0) {
        document.getElementById('time-remaining').textContent = 'Meeting has ended';
        window.location.reload();
      } else {
        const minutes = Math.floor(diff / 60000);
        const seconds = Math.floor((diff % 60000) / 1000);
        document.getElementById('time-remaining').textContent = `${minutes} minutes, ${seconds} seconds`;
      }
    }, 1000);
  });
</script>
