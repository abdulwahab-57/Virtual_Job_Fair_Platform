<div class="container mx-auto px-4 py-8">
  <div class="mb-8">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold text-gray-800">Job Fair Arena</h1>
      <div>
        <%= link_to "Create New Meeting", new_career_officer_meeting_path, class: "bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded" %>
      </div>
    </div>
    
    <% if @meetings.empty? %>
      <div class="bg-white rounded-lg shadow-lg p-8 text-center">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        <h2 class="mt-2 text-lg font-medium text-gray-900">No virtual booths available</h2>
        <p class="mt-1 text-gray-500">There are no active or upcoming virtual booths at the moment.</p>
        <div class="mt-6">
          <%= link_to "Schedule a Meeting", new_career_officer_meeting_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
        </div>
      </div>
    <% else %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @meetings.each do |meeting| %>
          <div class="h-full">
            <%= render VirtualBoothCardComponent.new(meeting: meeting) %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
