<div class="bg-white rounded-lg shadow-md p-6">
  <div class="flex items-center">
    <div class="w-16 h-16 bg-gray-200 rounded-full"></div>
    <div class="ml-4">
      <h1 class="text-xl font-bold"><%= @user.first_name || "Name" %></h1>
      <p class="text-gray-600"><%= @user.career_officer_profile.designation || "Designation" %></p>
    </div>
    <button class="ml-auto bg-blue-500 text-white px-4 py-2 rounded">Message</button>
  </div>

  <div class="mt-6">
    <div class="flex items-center text-gray-600">
      <span class="mr-2">📍</span><%= @user.career_officer_profile.office_location || "Office Location" %>
      <span class="mx-4">|</span>
      <span class="mr-2">📧</span><%= @user.email || "Email" %>
      <span class="mx-4">|</span>
      <span class="mr-2">📞</span><%= @user.career_officer_profile.phone || "Phone" %>
    </div>
  </div>

  <div class="mt-6">
    <h2 class="text-lg font-semibold">Introduction</h2>
    <p class="text-gray-600"><%= @user.career_officer_profile.introduction || "A brief bio highlighting the career officer's role, experience, and key areas of support." %></p>
  </div>

  <div class="mt-6">
    <h2 class="text-lg font-semibold">Education</h2>
    <p class="text-gray-600"><%= @user.career_officer_profile.education || "List of academic qualifications and relevant certifications." %></p>
  </div>
</div>
