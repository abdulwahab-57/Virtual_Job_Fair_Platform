<div class="container mx-auto px-4 py-8">
  <div class="flex justify-end items-center mb-6">
    <div>
      <%= link_to "New Meeting", new_career_officer_meeting_path, class: "bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded" %>
      <% unless current_user.has_zoom_credentials? %>
        <%= link_to "Connect to Zoom", zoom_auth_path, class: "bg-green-500 hover:bg-green-600 text-white font-semibold py-2 px-4 rounded ml-2" %>
      <% end %>
    </div>
  </div>

  <% if @meetings.empty? %>
    <div class="bg-white rounded-lg shadow p-6 text-center">
      <p class="text-gray-600">No meetings scheduled yet.</p>
    </div>
  <% else %>
    <div class="bg-white rounded-lg shadow overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Title</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Start Time</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">End Time</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Participants</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @meetings.each do |meeting| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <%= link_to meeting.title, career_officer_meeting_path(meeting), class: "text-blue-600 hover:text-blue-800" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <%= (meeting.start_time.utc + 5.hours).strftime("%b %d, %Y %I:%M %p") %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                  <%= (meeting.end_time.utc + 5.hours).strftime("%b %d, %Y %I:%M %p") %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                  <%= meeting.status == 'scheduled' ? 'bg-yellow-100 text-yellow-800' : 
                     meeting.status == 'started' ? 'bg-green-100 text-green-800' : 
                     meeting.status == 'ended' ? 'bg-gray-100 text-gray-800' : 
                     'bg-red-100 text-red-800' %>">
                  <%= meeting.status.capitalize %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <%= meeting.users.count %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <%= link_to "View", career_officer_meeting_path(meeting), class: "text-blue-600 hover:text-blue-900 mr-3" %>
                <%= link_to "Edit", edit_career_officer_meeting_path(meeting), class: "text-indigo-600 hover:text-indigo-900 mr-3" %>
                <%= button_to "Delete", career_officer_meeting_path(meeting), method: :delete, data: { confirm: "Are you sure?" }, class: "text-red-600 hover:text-red-900 bg-transparent border-none cursor-pointer" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
