<div class="flex justify-end mb-2">
    <div class="flex gap-2">
        <% if current_user.has_zoom_credentials? %>
            <%= button_to "Disconnect from Zoom", zoom_disconnect_path, method: :delete, class: "text-[#272F33]/[50%] border border-[#272F33]/[50%] font-semibold py-2 px-4 rounded-md" %>
            <%= link_to "+ Schedule a Meeting", new_career_officer_meeting_path, class: "bg-[#1499DC] hover:bg-[#0d7bbd] text-white font-semibold py-2 px-4 rounded-md" %>
        <% end %>
    </div>
</div>

<div class="p-6 bg-white rounded-md shadow-sm">
    <!-- Status Tabs -->
    <div class="flex border-b border-gray-200 mb-4">
        <button 
            data-tab="all" 
            data-action="click->select-all#switchTab" 
            class="px-6 py-3 text-sm font-medium hover:text-gray-700 text-[#1499DC] border-b-2 border-[#1499DC] focus:outline-none"
            data-select-all-target="activeTab">
            All
        </button>
        <%# <button 
            data-tab="reviewed" 
            data-action="click->select-all#switchTab" 
            class="px-6 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 border-b-2 border-transparent focus:outline-none">
            Reviewed
        </button>
        <button 
            data-tab="not-reviewed" 
            data-action="click->select-all#switchTab" 
            class="px-6 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 border-b-2 border-transparent focus:outline-none">
            Not Reviewed
        </button> %>
    </div>
    <% if @meetings.any? %>
        <div class="bg-white rounded-lg shadow-sm">
            <!-- Table -->
            <div class="overflow-y-auto">
                <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-8">
                                <input type="checkbox" class="h-4 w-4 text-[#1499DC] focus:ring-[#1499DC] border-gray-300 rounded "
                                data-select-all-target="checkboxAll"
                                data-action="change->select-all#toggleAll"
                                >
                    </th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                        Meeting ID
                    </th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                        Start Time
                    </th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                        Duration
                    </th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                        Actions
                    </th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200" data-select-all-target="tableBody">
                    <% @meetings.each do |meeting| %>
                        <tr class="hover:bg-gray-50" >
                            <td class="px-6 py-4 whitespace-nowrap">
                                <input type="checkbox" class="h-4 w-4 text-[#1499DC] focus:ring-[#1499DC] border-gray-300 rounded"
                                data-select-all-target="checkboxRow"
                                data-action="change->select-all#checkRowSelection">
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                <%= meeting.id %>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                <%= meeting.start_time.strftime("%Y-%m-%d %H:%M") if meeting.start_time %>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                <%= meeting.duration %> minutes
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 flex space-x-2">
                                <% if meeting.join_url.present? %>
                                    <%= link_to "Join", meeting.join_url, target: "_blank", rel: "noopener", class: "text-white bg-[#1499DC] border hover:border-[#1499DC] px-3 py-1 rounded" %>
                                <% else %>
                                    <span class="text-gray-400">No Join Link</span>
                                <% end %>
                                <%# link_to "Edit", edit_career_officer_student_profile_path(user.id), class: "text-white bg-[#272F33] border hover:border-[#272F33] px-3 py-1 rounded" %>
                            </td>
                        </tr>
                    <% end %>
                </tbody>
                </table>
            </div>
        </div>
    <% else %>
        <div class="text-center">
            <% if !current_user.has_zoom_credentials? %>
                <h2 class="text-lg font-semibold mb-2">Connect to Zoom to Schedule Meetings</h2>
                <p class="mb-4">To schedule and manage your meetings, please connect your Zoom account.</p>
                <%= link_to "Connect to Zoom", zoom_auth_path, class: "bg-[#1499DC] hover:bg-[#0d7bbd] text-white font-semibold py-2 px-4 rounded-md" %>
            <% else %>
                <p class="">No scheduled meetings found.</p>
            <% end %>
        </div>
    <% end %>
</div>
