<%= form_with scope: :meeting, url: career_officer_meetings_path, local: true, class: "bg-white rounded-md shadow p-6" do |form| %>
  <div class="mb-6">
    <!-- Topic Field -->
    <div class="mb-4">
      <label class="block text-sm font-medium text-gray-700 mb-1">Topic</label>
      <div class="relative">
        <%= form.text_field :topic, class: "w-full border border-gray-300 rounded-md p-2 focus:ring-blue-500 focus:border-blue-500", placeholder: "My Meeting" %>
      </div>
    </div>

  </div>

  <!-- Date and Time Section -->
  <div class="mb-6">
    <label class="block text-sm font-medium text-gray-700 mb-1">When</label>
    <div class="flex space-x-2 mb-2">
      <!-- Date Field -->
      <div class="w-1/2">
        <%= form.date_field :start_date, value: Time.current.strftime('%Y-%m-%d'), class: "w-full border border-gray-300 rounded-md p-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      
      <!-- Time Fields -->
      <div class="w-1/4">
        <%= form.select :start_hour, (1..12).map { |h| [h.to_s.rjust(2, '0'), h] }, { selected: Time.current.strftime('%I').to_i }, { class: "w-full border border-gray-300 rounded-md p-2 focus:ring-blue-500 focus:border-blue-500" } %>
      </div>
      
      <div class="w-1/4">
        <%= form.select :start_minute, (0..59).step(5).map { |m| [m.to_s.rjust(2, '0'), m] }, { selected: (Time.current.min / 5 * 5) }, { class: "w-full border border-gray-300 rounded-md p-2 focus:ring-blue-500 focus:border-blue-500" } %>
      </div>
      
      <!-- AM/PM Selection -->
      <div class="w-1/4">
        <%= form.select :am_pm, [['AM', 'AM'], ['PM', 'PM']], { selected: Time.current.strftime('%p') }, { class: "w-full border border-gray-300 rounded-md p-2 focus:ring-blue-500 focus:border-blue-500" } %>
      </div>
    </div>
  </div>

  <!-- Duration Section -->
  <div class="mb-6">
    <label class="block text-sm font-medium text-gray-700 mb-1">Duration</label>
    <div class="flex gap-2 items-center">
      <div class="w-1/5">
        <%= form.select :duration_hr, (0..24).map { |h| [h, h] }, { selected: 0 }, { class: "w-full border border-gray-300 rounded-md p-2 focus:ring-blue-500 focus:border-blue-500", disabled: true } %>
      </div>
      <div>
        <span class="text-gray-500">hr</span>
      </div>
      
      <div class="w-1/5">
        <%= form.select :duration_min, [0, 15, 30, 40].map { |m| [m, m] }, { selected: 40 }, { class: "w-full border border-gray-300 rounded-md p-2 focus:ring-blue-500 focus:border-blue-500" } %>
      </div>
      <div>
        <span class="text-gray-500">min</span>
      </div>
    </div>
    
    <!-- Basic Plan Notice -->
    <div class="mt-2 text-xs text-gray-600 bg-yellow-50 p-3 rounded-md">
      You can schedule meetings for up to 40 minutes each with your current Basic plan. Need more time?
      <a href="#" class="text-blue-600 hover:underline">Upgrade to Zoom Workspace Pro</a>
    </div>
  </div>


  <!-- Invitees Section -->
  <div class="mb-6">
    <label class="block text-sm font-medium text-gray-700 mb-1">Invitees</label>
    <%= form.text_field :invitees, class: "w-full border border-gray-300 rounded-md p-2 focus:ring-blue-500 focus:border-blue-500", placeholder: "Enter user names or email addresses" %>
  </div>

  <!-- Form Buttons -->
  <div class="flex items-center gap-2">
    <%= form.submit "Save", class: "px-4 py-2 bg-[#1499DC] text-white rounded-md hover:bg-[#0d7bbd] focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>
    <%= link_to "Cancel", career_officer_meetings_path, class: "px-4 py-2 text-gray-700 border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2" %>
  </div>
<% end %>

