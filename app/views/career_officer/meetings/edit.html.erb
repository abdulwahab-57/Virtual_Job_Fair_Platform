<div class="container mx-auto px-4 py-8">
  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with(model: [:career_officer, @meeting], local: true) do |form| %>
      <% if @meeting.errors.any? %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
          <h2 class="font-bold mb-2"><%= pluralize(@meeting.errors.count, "error") %> prohibited this meeting from being saved:</h2>
          <ul class="list-disc list-inside">
            <% @meeting.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-4">
        <%= form.label :title, class: "block text-gray-700 text-sm font-bold mb-2" %>
        <%= form.text_field :title, class: "appearance-none border border-gray-300 rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" %>
      </div>

      <div class="mb-4">
        <%= form.label :description, class: "block text-gray-700 text-sm font-bold mb-2" %>
        <%= form.text_area :description, rows: 4, class: "appearance-none border border-gray-300 rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
        <div>
          <%= form.label :start_time, class: "block text-gray-700 text-sm font-bold mb-2" %>
          <%= form.datetime_local_field :start_time, value: (@meeting.start_time.present? ? (@meeting.start_time.utc + 5.hours).strftime('%Y-%m-%dT%H:%M') : nil), class: "appearance-none border border-gray-300 rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" %>
        </div>
        <div>
          <%= form.label :end_time, class: "block text-gray-700 text-sm font-bold mb-2" %>
          <%= form.datetime_local_field :end_time, value: (@meeting.end_time.present? ? (@meeting.end_time.utc + 5.hours).strftime('%Y-%m-%dT%H:%M') : nil), class: "appearance-none border border-gray-300 rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" %>
        </div>
      </div>

      <div class="mb-4 text-gray-700" data-controller="multi-select" data-multi-select-placeholder-value="Select students to add to the meeting">
        <h3 class="text-gray-700 text-sm font-bold mb-2">Add Students</h3>
        <%= select_tag 'student_ids[]', 
                      options_from_collection_for_select(@students, :id, :full_name, @meeting.student_participants.pluck(:id)), 
                      multiple: true,
                      data: { 
                        multi_select_target: "select",
                        options: @students.map { |s| { value: s.id, text: s.full_name } }.to_json
                      },
                      class: "hidden" %>
        <p class="text-sm text-gray-500 mt-1">Click on options to select/deselect</p>
      </div>

      <div class="mb-6 text-gray-700" data-controller="multi-select" data-multi-select-placeholder-value="Select recruiters to add to the meeting">
        <h3 class="text-gray-700 text-sm font-bold mb-2">Add Recruiters</h3>
        <%= select_tag 'recruiter_ids[]', 
                      options_from_collection_for_select(@recruiters, :id, lambda { |r| "#{r.full_name} (#{r.recruiter_profile.company_name})" }, @meeting.recruiter_participants.pluck(:id)), 
                      multiple: true,
                      data: { 
                        multi_select_target: "select",
                        options: @recruiters.map { |r| { value: r.id, text: "#{r.full_name} (#{r.recruiter_profile.company_name})" } }.to_json
                      },
                      class: "hidden" %>
        <p class="text-sm text-gray-500 mt-1">Click on options to select/deselect</p>
      </div>

      <div class="flex items-center gap-4">
        <%= form.submit "Update Meeting", class: "bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded focus:outline-none focus:shadow-outline" %>
        <%= link_to "Cancel", career_officer_meeting_path(@meeting), class: "bg-gray-200 text-gray-700 hover:bg-gray-300 hover:text-gray-800 py-2 px-4 rounded" %>
      </div>
    <% end %>
  </div>
</div>
