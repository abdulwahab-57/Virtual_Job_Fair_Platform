<div class="flex flex-col" style="min-height: calc(100vh - 4rem);" data-controller="table-actions">

  <%# ── Page header + bulk action bar ──────────────────────────────── %>
  <div class="bg-white border-b border-slate-200 px-6 py-4 flex items-center justify-between gap-4">
    <div>
      <h1 class="text-lg font-bold text-slate-900">Student Profiles</h1>
      <p class="text-sm text-slate-500 mt-0.5">Manage and review all student submissions</p>
    </div>

    <div data-table-actions-target="selectionSummary"
         class="hidden flex items-center gap-3 bg-[#EBF7FF] border border-[#1499DC]/30 rounded-lg px-3 py-2">
      <span class="bg-[#1499DC] text-white text-xs font-semibold px-2 py-1 rounded">
        <span data-table-actions-target="selectedCount">0</span> selected
      </span>
      <select data-table-actions-target="actionsSelect"
              data-action="change->table-actions#performAction"
              class="border border-slate-300 rounded-md px-3 py-1 text-sm text-slate-700 bg-white focus:ring-[#1499DC] focus:border-[#1499DC]">
        <option value="" disabled selected>Actions…</option>
        <option value="download_profiles">Download PDFs</option>
      </select>
      <button data-action="click->table-actions#clearSelectedRows"
              class="text-slate-400 hover:text-slate-600 focus:outline-none"
              aria-label="Clear selection">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
        </svg>
      </button>
    </div>
  </div>

  <%# ── Body: sidebar + table ───────────────────────────────────────── %>
  <div class="flex flex-1">

    <%# Left filter sidebar %>
    <%= render Table::FilterSidebarComponent.new do |c| %>
      <% c.with_form_content do %>
        <%= search_form_for @q, url: career_officer_student_profiles_path, method: :get do |f| %>

          <%# Search input %>
          <div class="flex items-center gap-2 border border-slate-200 rounded-lg px-3 py-2 mb-5 focus-within:ring-2 focus-within:ring-[#1499DC]/30 focus-within:border-[#1499DC] transition-colors">
            <svg class="w-3.5 h-3.5 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
            </svg>
            <%= f.search_field :full_name_or_email_cont,
                  placeholder: "Search name or email…",
                  class: "flex-1 text-sm text-slate-700 bg-transparent outline-none border-0 ring-0 focus:outline-none focus:ring-0 focus:border-0 min-w-0" %>
          </div>

          <%# Status filter %>
          <div class="mb-5">
            <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Status</p>
            <% ["Reviewed", "Not Reviewed"].each do |status| %>
              <label class="flex items-center gap-2 text-sm text-slate-700 mb-2 cursor-pointer">
                <%= f.check_box :student_profile_status_in,
                      { multiple: true,
                        checked: Array(params.dig(:q, :student_profile_status_in)).include?(status),
                        class: "h-4 w-4 rounded border-slate-300 text-[#1499DC] focus:ring-[#1499DC]" },
                      status, nil %>
                <%= status %>
              </label>
            <% end %>
          </div>

          <hr class="border-slate-100 mb-5">

          <%# Graduation year filter %>
          <div class="mb-5">
            <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Graduation Year</p>
            <div class="max-h-32 overflow-y-auto space-y-2">
              <% @graduation_year_options.each do |year| %>
                <label class="flex items-center gap-2 text-sm text-slate-700 cursor-pointer">
                  <%= f.check_box :student_profile_educations_graduation_year_in,
                        { multiple: true,
                          checked: Array(params.dig(:q, :student_profile_educations_graduation_year_in)).include?(year.to_s),
                          class: "h-4 w-4 rounded border-slate-300 text-[#1499DC] focus:ring-[#1499DC]" },
                        year, nil %>
                  <%= year %>
                </label>
              <% end %>
            </div>
          </div>

          <hr class="border-slate-100 mb-5">

          <%# Degree filter %>
          <div class="mb-5">
            <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Degree</p>
            <div class="max-h-32 overflow-y-auto space-y-2">
              <% @degree_options.each do |degree| %>
                <label class="flex items-start gap-2 text-sm text-slate-700 cursor-pointer">
                  <%= f.check_box :student_profile_educations_degree_in,
                        { multiple: true,
                          checked: Array(params.dig(:q, :student_profile_educations_degree_in)).include?(degree),
                          class: "mt-0.5 h-4 w-4 rounded border-slate-300 text-[#1499DC] focus:ring-[#1499DC]" },
                        degree, nil %>
                  <span class="leading-snug"><%= degree %></span>
                </label>
              <% end %>
            </div>
          </div>

          <%# Submit / clear %>
          <div class="flex flex-col gap-2 mt-2">
            <%= f.submit "Apply Filters",
                  class: "w-full cursor-pointer bg-[#1499DC] hover:bg-[#1187c3] text-white text-sm font-semibold py-2 rounded-lg transition-colors" %>
            <%= link_to "Clear All", career_officer_student_profiles_path,
                  class: "w-full text-center text-sm text-slate-500 hover:text-slate-700 border border-slate-200 hover:border-slate-300 py-2 rounded-lg transition-colors" %>
          </div>

        <% end %>
      <% end %>
    <% end %>

    <%# ── Main table area ─────────────────────────────────────────────── %>
    <div class="flex-1 p-5 bg-slate-50 overflow-x-auto">
      <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">

        <table class="w-full min-w-[700px]">
          <thead class="bg-slate-50 border-b border-slate-200">
            <tr>
              <th class="px-4 py-3 w-10">
                <input type="checkbox"
                       class="h-4 w-4 rounded border-slate-300 text-[#1499DC] focus:ring-[#1499DC]"
                       data-table-actions-target="checkboxAll"
                       data-action="change->table-actions#toggleAll">
              </th>
              <th class="px-4 py-3 text-left cursor-pointer select-none hover:bg-slate-100 transition-colors group">
                <%= sort_link @q, :full_name, "Student",
                      class: "text-xs font-bold text-slate-500 uppercase tracking-wider group-hover:text-[#1499DC] transition-colors" %>
              </th>
              <th class="px-4 py-3 text-left cursor-pointer select-none hover:bg-slate-100 transition-colors group">
                <%= sort_link @q, :email, "Email",
                      class: "text-xs font-bold text-slate-500 uppercase tracking-wider group-hover:text-[#1499DC] transition-colors" %>
              </th>
              <th class="px-4 py-3 text-left cursor-pointer select-none hover:bg-slate-100 transition-colors group">
                <%= sort_link @q, :student_profile_status, "Status",
                      class: "text-xs font-bold text-slate-500 uppercase tracking-wider group-hover:text-[#1499DC] transition-colors" %>
              </th>
              <th class="px-4 py-3 text-left cursor-pointer select-none hover:bg-slate-100 transition-colors group">
                <%= sort_link @q, :updated_at, "Last Updated",
                      class: "text-xs font-bold text-slate-500 uppercase tracking-wider group-hover:text-[#1499DC] transition-colors" %>
              </th>
              <th class="px-4 py-3 w-12"></th>
            </tr>
          </thead>

          <tbody class="divide-y divide-slate-100" data-table-actions-target="tableBody">
            <% @users.each do |user| %>
              <% profile    = user.student_profile %>
              <% primary_ed = profile&.educations&.find { |e| e.degree.to_s.match?(/\ABS \(|\ABachelor of Business Administration/) } %>
              <% status     = profile&.status || "Not Reviewed" %>
              <tr class="hover:bg-slate-50 transition-colors"
                  data-user-id="<%= user.id %>"
                  data-status="<%= status.downcase.gsub(/\s+/, "-") %>">

                <%# Checkbox %>
                <td class="px-4 py-3">
                  <input type="checkbox"
                         class="h-4 w-4 rounded border-slate-300 text-[#1499DC] focus:ring-[#1499DC]"
                         data-table-actions-target="checkboxRow"
                         data-action="change->table-actions#checkRowSelection">
                </td>

                <%# Avatar + name + degree/year %>
                <td class="px-4 py-3">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full flex-shrink-0 flex items-center justify-center text-xs font-bold <%= student_initials_color(user.id) %>">
                      <%= student_initials(user.full_name) %>
                    </div>
                    <div class="min-w-0">
                      <div class="text-sm font-semibold text-slate-900 truncate"><%= user.full_name %></div>
                      <div class="text-xs text-slate-400 truncate">
                        <%= [primary_ed&.degree, primary_ed&.graduation_year].compact.join(" · ").presence || "—" %>
                      </div>
                    </div>
                  </div>
                </td>

                <%# Email %>
                <td class="px-4 py-3 text-sm text-slate-600"><%= user.email %></td>

                <%# Clickable status badge %>
                <td class="px-4 py-3">
                  <%= render StatusBadgeComponent.new(
                        status: status,
                        data: { action: "click->table-actions#openStatusModal" }
                      ) %>
                </td>

                <%# Last updated %>
                <td class="px-4 py-3 text-sm text-slate-500">
                  <%= profile&.updated_at&.strftime("%b %d, %Y") || "—" %>
                </td>

                <%# Three-dot actions dropdown %>
                <td class="px-4 py-3">
                  <%= render Table::ActionsDropdownComponent.new(actions: [
                        { label: "View Profile", url: career_officer_student_profile_path(user.id),      icon: :view },
                        { label: "Edit Profile", url: edit_career_officer_student_profile_path(user.id), icon: :edit },
                        { label: "Download PDF", url: download_profiles_career_officer_student_profiles_path(format: :pdf, user_ids: [user.id]),
                          icon: :pdf, divider_before: true }
                      ]) %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <%# Pagy pagination footer %>
        <%= render Table::PaginationComponent.new(pagy: @pagy) %>

      </div>
    </div>
  </div>

  <%# ── Status change modal ─────────────────────────────────────────── %>
  <div data-table-actions-target="statusModal"
       class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center"
       role="dialog" aria-modal="true" aria-labelledby="status-modal-title">
    <div class="bg-white rounded-xl shadow-2xl p-6 w-80">
      <h2 id="status-modal-title" class="text-base font-semibold text-slate-900 mb-4">Change Status</h2>
      <div class="space-y-1">
        <button data-action="click->table-actions#changeStatus" data-status="Reviewed"
                class="w-full text-left px-3 py-2.5 text-sm text-slate-700 hover:bg-slate-50 rounded-lg flex items-center gap-2 transition-colors">
          <span class="w-3 h-3 rounded-full bg-green-400 flex-shrink-0"></span>
          Reviewed
        </button>
        <button data-action="click->table-actions#changeStatus" data-status="Not Reviewed"
                class="w-full text-left px-3 py-2.5 text-sm text-slate-700 hover:bg-slate-50 rounded-lg flex items-center gap-2 transition-colors">
          <span class="w-3 h-3 rounded-full bg-red-400 flex-shrink-0"></span>
          Not Reviewed
        </button>
      </div>
      <div class="mt-5 flex justify-end gap-2">
        <button data-action="click->table-actions#closeStatusModal"
                class="px-4 py-2 text-sm text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors">
          Cancel
        </button>
        <button data-action="click->table-actions#applyStatus"
                class="px-4 py-2 text-sm text-white bg-[#1499DC] hover:bg-[#1187c3] rounded-lg transition-colors">
          Apply
        </button>
      </div>
    </div>
  </div>

</div>
