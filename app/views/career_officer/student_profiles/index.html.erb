<div class="max-w-[1121px] mx-auto min-h-screen" data-controller="select-all">
  <div>
      <!-- Selection Summary -->
      <div data-select-all-target="selectionSummary" class="flex items-center bg-gray-100 rounded-lg p-2 space-x-3" >
        <div class="bg-[#1499DC] text-white px-2 py-1 rounded text-sm font-medium">
          <span data-select-all-target="selectedCount">0</span> selected
        </div>

        <select data-select-all-target="actionsSelect" data-action="change->select-all#performAction" class="flex items-center bg-white border border-gray-300 rounded-md px-3 py-1 text-sm hover:bg-gray-50" >
          <option value="" disabled selected>Actions</option>
          <option value="download_profiles">Download Profiles</option>
        </select>

        <button data-select-all-target="clearSelection" data-action="click->select-all#clearSelectedRows" class="text-gray-500 hover:text-gray-700" >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
        </button>
      </div>

      <!-- Table section -->
      <div class="p-6 bg-white rounded-md shadow-sm">
        <!-- Status Filters + Degree/Year Filters -->
        <div class="flex flex-wrap items-center justify-between border-b border-gray-200 mb-4">
          <div class="flex flex-wrap items-center gap-6 py-3 text-sm text-gray-700">
            <label class="flex items-center gap-2">
              <input type="checkbox"
                value="reviewed"
                class="h-4 w-4 text-[#1499DC] focus:ring-[#1499DC] border-gray-300 rounded"
                data-select-all-target="statusCheckbox"
                data-action="change->select-all#applyFilters">
              <span>Reviewed</span>
            </label>
            <label class="flex items-center gap-2">
              <input type="checkbox"
                value="not-reviewed"
                class="h-4 w-4 text-[#1499DC] focus:ring-[#1499DC] border-gray-300 rounded"
                data-select-all-target="statusCheckbox"
                data-action="change->select-all#applyFilters">
              <span>Not Reviewed</span>
            </label>
            <span class="text-xs text-gray-400">(Leave unchecked to show all)</span>
          </div>

          <div class="flex flex-wrap items-center gap-4 py-3">
          <details class="group relative">
            <summary class="cursor-pointer list-none rounded-md border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50">
              Graduation Year
            </summary>
            <div class="absolute left-0 z-20 mt-2 w-56 rounded-md border border-gray-200 bg-white p-3 shadow-lg">
              <div class="max-h-56 overflow-y-auto space-y-2 text-sm text-gray-700">
                <% @graduation_year_options.each do |year| %>
                  <label class="flex items-center gap-2">
                    <input type="checkbox"
                      value="<%= year %>"
                      class="h-4 w-4 text-[#1499DC] focus:ring-[#1499DC] border-gray-300 rounded"
                      data-select-all-target="yearCheckbox"
                      data-action="change->select-all#applyFilters">
                    <span><%= year %></span>
                  </label>
                <% end %>
              </div>
            </div>
          </details>

          <details class="group relative">
            <summary class="cursor-pointer list-none rounded-md border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50">
              Degree
            </summary>
            <div class="absolute left-0 z-20 mt-2 w-72 rounded-md border border-gray-200 bg-white p-3 shadow-lg">
              <div class="max-h-56 overflow-y-auto space-y-2 text-sm text-gray-700">
                <% @degree_options.each do |degree| %>
                  <label class="flex items-start gap-2">
                    <input type="checkbox"
                      value="<%= degree %>"
                      class="mt-1 h-4 w-4 text-[#1499DC] focus:ring-[#1499DC] border-gray-300 rounded"
                      data-select-all-target="degreeCheckbox"
                      data-action="change->select-all#applyFilters">
                    <span><%= degree %></span>
                  </label>
                <% end %>
              </div>
            </div>
          </details>
          </div>
        </div>

        <div class="bg-white rounded-lg shadow-sm">
          <!-- Table -->
          <div class="overflow-y-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-8">
                    <input type="checkbox" class="h-4 w-4 text-[#1499DC] focus:ring-[#1499DC] border-gray-300 rounded "
                    data-select-all-target="checkboxAll"
                    data-action="change->select-all#toggleAll"
                    >
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Student Name
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Email
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Status
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Last Updated
                  </th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Actions
                  </th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200" data-select-all-target="tableBody">
                <!-- Row 1 -->
                <% @users.each do |user| %>
                  <% degrees = user.student_profile.educations.map(&:degree).compact %>
                  <% graduation_years = user.student_profile.educations.map(&:graduation_year).compact %>
                  <tr class="hover:bg-gray-50"
                    data-status="<%= user.student_profile.status.downcase.gsub(' ', '-') %>"
                    data-user-id="<%= user.id %>"
                    data-degree="<%= degrees.join('|') %>"
                    data-grad-year="<%= graduation_years.join('|') %>">
                    <td class="px-6 py-4 whitespace-nowrap">
                      <input type="checkbox" class="h-4 w-4 text-[#1499DC] focus:ring-[#1499DC] border-gray-300 rounded"
                      data-select-all-target="checkboxRow"
                      data-action="change->select-all#checkRowSelection">
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                      <%= user.full_name %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                      <%= user.email %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                      <span data-action="click->select-all#openStatusModal" 
                        class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                        <%= user.student_profile.status == 'Not Reviewed' ? 'bg-red-100 text-red-800' : 'bg-gray-100 text-gray-800' %> cursor-pointer">
                        <%= user.student_profile.status %>
                      </span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                      <%= user.student_profile.updated_at %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 flex space-x-2">
                      <%= link_to "View", career_officer_student_profile_path(user.id), class: "text-white bg-[#1499DC] border hover:border-[#1499DC] px-3 py-1 rounded" %>
                      <%= link_to "Edit", edit_career_officer_student_profile_path(user.id), class: "text-white bg-[#272F33] border hover:border-[#272F33] px-3 py-1 rounded" %>
                    </td>
                  </tr>
                <% end %>

              </tbody>
            </table>
          </div>
        </div>
      </div>
  </div>
  <!-- Status Change Modal -->
  <div data-select-all-target="statusModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center">
    <div class="bg-white rounded-lg shadow-xl p-6 w-96">
      <h2 class="text-lg font-semibold mb-4">Change status</h2>
      <div class="space-y-2">
        <button data-action="click->select-all#changeStatus" data-status="Reviewed" class="w-full text-left px-4 py-2 hover:bg-gray-100 rounded flex items-center" >
          <span class="w-4 h-4 mr-2 rounded-full bg-gray-100"></span>
          Reviewed
        </button>
        <button data-action="click->select-all#changeStatus" data-status="Not Reviewed" class="w-full text-left px-4 py-2 hover:bg-gray-100 rounded flex items-center" >
          <span class="w-4 h-4 mr-2 rounded-full bg-red-100"></span>
          Not Reviewed
        </button>
      </div>
      <div class="mt-4 flex justify-end space-x-2">
        <button 
          data-action="click->select-all#closeStatusModal"
          class="px-4 py-2 bg-gray-200 text-gray-700 rounded"
        >
          Cancel
        </button>
        <button 
          data-action="click->select-all#applyStatus"
          class="px-4 py-2 bg-indigo-600 text-white rounded"
        >
          Apply
        </button> 
      </div>
    </div>
  </div>
</div>



