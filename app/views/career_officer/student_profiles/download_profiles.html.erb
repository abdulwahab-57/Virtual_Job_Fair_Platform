<% @users.each_with_index do |user, index| %>
  <div class="max-w-4xl mx-auto">
    <div class="flex justify-between mb-9">
      <img src="http://localhost:3000/fast_logo_top_left.png" alt="National University Logo" style="height: 66.24px; width: auto;">
      <img src="http://localhost:3000/fast_logo_top_right.png" alt="National University Logo" style="height: 66.24px; width: auto;">
    </div>
    <div class="grid grid-cols-[20%_1fr] grid-rows-[auto] gap-x-4 gap-y-6">
      <div class="col-start-1 row-start-1 justify-self-center">
        <% if user.profile_picture.attached? %>
          <% resized = user.profile_picture.variant(resize_to_fill: [120, 120]).processed %>
          <% image_data = resized.download %>
          <% base64_image = Base64.strict_encode64(image_data) %>
          <img src="data:image/<%= user.profile_picture.content_type %>;base64,<%= base64_image %>">
        <% else %>
          <%= image_tag "https://placehold.co/120x120", size: "120x120" %>
        <% end %>
      </div>
      <div class="col-start-2 row-start-1 leading-8">
          <h1 class="text-[28pt] font-bold"><%= user.full_name %></h1>
          <p class="text-[17pt] font-bold"><%= user.student_profile.educations.first&.degree %></p>
      </div>
      <div class="col-start-1 row-start-2 bg-[#1499DC]">
        <div class="text-right text-[9.5pt] text-white px-4 pt-8">
          <ul class="break-all space-y-4">
            <li>
              <p><strong>Date of Birth</strong></p>
              <p><%= user.student_profile.date_of_birth.strftime("%d/%m/%Y") if user.student_profile.date_of_birth.present? %></p>
            </li>
            <li>
              <p><strong>Telephone</strong></p>
              <p><%= user.student_profile.phone_number %></p>
            </li>
            <li>
              <p><strong>Email</strong></p>
              <ul>
                <li><%= user.email %></li>
                <li><%= user.student_profile.email_personal %></li>
              </ul>
            </li>
            <li>
              <p><strong>Address</strong></p>
              <p><%= user.student_profile.address %></p>
            </li>
            <li>
              <p><strong>LinkedIn</strong></p>
              <p><%= user.student_profile.linkedin_url %></p>
            </li>
            <li>
              <p><strong>Preference for Job</strong></p>
              <ul>
                <% user.student_profile.location_preferences.each do |loc| %>
                  <li><%= loc.location %></li>
                <% end %>
              </ul>
            </li>
          </ul>
        </div>
      </div>
      <div class="col-start-2 row-start-2 -mt-12 text-justify">
          <!-- Education Section -->
          <section class="mb-2">
            <h2 class="text-[12pt] font-bold border-b text-[#1499DC] border-[#1499DC]">Education</h2>
            <ul class="mt-2">
              <% user.student_profile.educations.each_with_index do |education, index| %>
                <li>
                  <% if index == 0 %>
                    <p class="text-[10pt] font-bold">National University of Computer and Emerging Sciences, Chiniot-Faisalabad Campus</p>
                    <p class="text-[10pt]"><%= "#{education.degree} - #{Date.today.year}" %></p>
                  <% else %>
                    <p class="text-[10pt] font-bold"><%= education.institution_name %></p>
                    <p class="text-[10pt]"><%= "#{education.degree} - #{education.graduation_year}" %></p>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </section>

          <!-- Projects Section -->
          <section class="mb-1">
            <h2 class="text-[12pt] font-bold border-b text-[#1499DC] border-[#1499DC]">Projects/Portfolio</h2>
            <ul class="mt-2">
              <% user.student_profile.projects.each do |project| %>
                <li>
                  <p class="text-[10pt] font-bold"><%= project.project_name %></p>
                  <p class="text-[10pt]"><%= project.description %></p>
                </li>
              <% end %>
            </ul>
          </section>

          <!-- Activities Section -->
          <section class="mb-1">
            <h2 class="text-[12pt] font-bold border-b text-[#1499DC] border-[#1499DC]">Activities, Honors & Awards</h2>
            <ul class="mt-2">
              <% user.student_profile.activities_honors.each do |activity| %>
                <li>
                  <span class="text-[10pt] font-bold"><%= activity.title %></span>, <span class="text-[10pt]"><%= activity.organization %></span>
                </li>
              <% end %>
            </ul>
          </section>

          <!-- Skills Section -->
          <section class="mb-1">
            <h2 class="text-[12pt] font-bold border-b text-[#1499DC] border-[#1499DC]">Skills & Tools</h2>
            <ul class="mt-2">
              <% user.student_profile.skills.each do |skill| %>
                <li>
                  <p class="text-[10pt] font-bold"><%= skill.title %></p>
                  <p class="text-[10pt]"><%= skill.skill_list %></p>
                </li>
              <% end %>
            </ul>
          </section>

          <!-- Interests Section -->
          <section>
            <h2 class="text-[12pt] font-bold border-b text-[#1499DC] border-[#1499DC]">Interests & Hobbies</h2>
            <p class="mt-2 text-[10pt]"><%= user.student_profile&.interests&.first&.interest_list %></p>
          </section>
      </div>
    </div>
  </div>
  <% if index < @users.size - 1 %>
    <div class="break-before-page h-0"></div>
  <% end %>
<% end %>