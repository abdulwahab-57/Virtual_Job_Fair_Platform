<div class="bg-gray-50 min-h-screen">
  <!-- Header Section -->
  <div class="bg-gradient-to-r from-purple-700 to-purple-900 py-8 px-6 shadow-md">
    <h1 class="text-3xl font-bold text-white">Welcome to Your Career Officer Dashboard</h1>
    <p class="text-purple-100 mt-2">Monitor, manage, and facilitate student-recruiter connections</p>
  </div>

  <div class="container mx-auto px-4 py-8">
    <!-- Dashboard Overview -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
      <!-- Total Students Card -->
      <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
        <div class="flex justify-between">
          <div>
            <p class="text-gray-500 text-sm uppercase tracking-wider">Total Students</p>
            <h2 class="text-3xl font-bold text-gray-800" id="student-count">--</h2>
          </div>
          <div class="bg-blue-100 p-3 rounded-full">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path d="M12 14l9-5-9-5-9 5 9 5z" />
              <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
            </svg>
          </div>
        </div>
        <div class="mt-4">
          <span class="text-gray-600 text-sm">Registered in the platform</span>
        </div>
      </div>

      <!-- Total Recruiters Card -->
      <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
        <div class="flex justify-between">
          <div>
            <p class="text-gray-500 text-sm uppercase tracking-wider">Total Recruiters</p>
            <h2 class="text-3xl font-bold text-gray-800" id="recruiter-count">--</h2>
          </div>
          <div class="bg-green-100 p-3 rounded-full">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
        </div>
        <div class="mt-4">
          <span class="text-gray-600 text-sm">Active company accounts</span>
        </div>
      </div>

      <!-- Job Postings Card -->
      <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
        <div class="flex justify-between">
          <div>
            <p class="text-gray-500 text-sm uppercase tracking-wider">Job Postings</p>
            <h2 class="text-3xl font-bold text-gray-800" id="jobs-count">--</h2>
          </div>
          <div class="bg-yellow-100 p-3 rounded-full">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
          </div>
        </div>
        <div class="mt-4">
          <span class="text-gray-600 text-sm">Available job listings</span>
        </div>
      </div>

      <!-- System Status Card -->
      <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
        <div class="flex justify-between">
          <div>
            <p class="text-gray-500 text-sm uppercase tracking-wider">System Status</p>
            <h2 class="text-3xl font-bold text-green-600">Active</h2>
          </div>
          <div class="bg-purple-100 p-3 rounded-full">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
        </div>
        <div class="mt-4">
          <span class="text-gray-600 text-sm">All services operational</span>
        </div>
      </div>
    </div>

    <!-- Main Actions Section -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Student Management Card -->
      <div class="bg-white rounded-lg shadow-md p-6 border-t-4 border-blue-500 hover:shadow-lg transition-shadow">
        <div class="flex justify-between items-start">
          <div>
            <h2 class="text-xl font-bold text-gray-800 mb-2">Student Management</h2>
            <p class="text-gray-600 mb-4">Review, approve, and manage student profiles and applications.</p>
          </div>
          <div class="bg-blue-100 p-3 rounded-full">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
        </div>
        <%= link_to career_officer_student_profiles_path, class: 'mt-4 block w-full text-center py-2 px-4 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-md transition-colors' do %>
          Manage Student Profiles
        <% end %>
      </div>

      <!-- Recruiter Management Card -->
      <div class="bg-white rounded-lg shadow-md p-6 border-t-4 border-green-500 hover:shadow-lg transition-shadow">
        <div class="flex justify-between items-start">
          <div>
            <h2 class="text-xl font-bold text-gray-800 mb-2">Recruiter Management</h2>
            <p class="text-gray-600 mb-4">Review and approve recruiter profiles and job postings.</p>
          </div>
          <div class="bg-green-100 p-3 rounded-full">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
        </div>
        <a href="#" class="mt-4 block w-full text-center py-2 px-4 bg-green-600 hover:bg-green-700 text-white font-medium rounded-md transition-colors">
          Manage Recruiters
        </a>
      </div>

      <!-- Event Management Card -->
      <div class="bg-white rounded-lg shadow-md p-6 border-t-4 border-purple-500 hover:shadow-lg transition-shadow">
        <div class="flex justify-between items-start">
          <div>
            <h2 class="text-xl font-bold text-gray-800 mb-2">Event Management</h2>
            <p class="text-gray-600 mb-4">Plan and organize virtual job fairs and networking events.</p>
          </div>
          <div class="bg-purple-100 p-3 rounded-full">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
        </div>
        <a href="#" class="mt-4 block w-full text-center py-2 px-4 bg-purple-600 hover:bg-purple-700 text-white font-medium rounded-md transition-colors">
          Manage Events
        </a>
      </div>
    </div>

    <!-- Analytics Overview -->
    <div class="mt-10">
      <h2 class="text-2xl font-bold text-gray-800 mb-6">Analytics Overview</h2>
      <div class="bg-white rounded-lg shadow-md p-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- Student Status Distribution -->
          <div class="p-6 border border-gray-200 rounded-lg">
            <h3 class="font-bold text-gray-800 mb-4 flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
              Student Status Distribution
            </h3>
            <div id="status-chart" class="h-64 flex items-center justify-center">
              <div class="text-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-300 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
                <p class="mt-4 text-gray-500">Status distribution chart will be available soon</p>
              </div>
            </div>
          </div>
          
          <!-- Profile Completion -->
          <div class="p-6 border border-gray-200 rounded-lg">
            <h3 class="font-bold text-gray-800 mb-4 flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Profile Completion Rates
            </h3>
            <div id="completion-chart" class="h-64 flex items-center justify-center">
              <div class="text-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-300 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z" />
                </svg>
                <p class="mt-4 text-gray-500">Completion rate chart will be available soon</p>
              </div>
            </div>
          </div>
        </div>
        
        <div class="mt-6 text-right">
          <a href="#" class="text-purple-600 hover:text-purple-800 font-medium flex items-center justify-end">
            View Detailed Analytics
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Recent Activity -->
    <div class="mt-10">
      <h2 class="text-2xl font-bold text-gray-800 mb-6">Recent Activity</h2>
      <div class="bg-white rounded-lg shadow-md p-6">
        <div class="border-b pb-4 mb-4">
          <div class="flex items-start">
            <div class="bg-blue-100 p-2 rounded-full mr-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
              </svg>
            </div>
            <div>
              <p class="text-gray-800 font-medium">New student registration</p>
              <p class="text-gray-500 text-sm">A new student has registered and is awaiting profile approval.</p>
              <p class="text-gray-400 text-xs mt-1">Just now</p>
            </div>
          </div>
        </div>
        
        <div class="border-b pb-4 mb-4">
          <div class="flex items-start">
            <div class="bg-green-100 p-2 rounded-full mr-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <p class="text-gray-800 font-medium">Recruiter profile approved</p>
              <p class="text-gray-500 text-sm">Acme Corporation's profile has been approved.</p>
              <p class="text-gray-400 text-xs mt-1">2 hours ago</p>
            </div>
          </div>
        </div>
        
        <div>
          <div class="flex items-start">
            <div class="bg-yellow-100 p-2 rounded-full mr-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
            </div>
            <div>
              <p class="text-gray-800 font-medium">Event scheduled</p>
              <p class="text-gray-500 text-sm">Summer Virtual Job Fair has been scheduled for June 15.</p>
              <p class="text-gray-400 text-xs mt-1">Yesterday</p>
            </div>
          </div>
        </div>
        
        <div class="mt-6 text-center">
          <a href="#" class="text-purple-600 hover:text-purple-800 text-sm">View all activity</a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Add subtle animation to cards
  const cards = document.querySelectorAll('.rounded-lg');
  cards.forEach((card, index) => {
    card.style.opacity = '0';
    card.style.transform = 'translateY(20px)';
    card.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
    
    setTimeout(() => {
      card.style.opacity = '1';
      card.style.transform = 'translateY(0)';
    }, 100 * index);
  });
  
  // Simulate loading dashboard data
  setTimeout(() => {
    document.getElementById('student-count').textContent = '168';
    document.getElementById('recruiter-count').textContent = '42';
    document.getElementById('jobs-count').textContent = '73';
  }, 1000);
});
</script>
