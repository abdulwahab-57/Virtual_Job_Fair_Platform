<div class="analytics-dashboard space-y-6">
  <h1 class="text-2xl font-bold mb-4">Enhanced Analytics for <%= @recruiter.full_name %></h1>
  
  <!-- Profile Overview Section -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="card p-4 border rounded-lg shadow-md bg-white">
      <h2 class="text-lg font-semibold mb-2 text-blue-700">Profile Completion</h2>
      <div class="text-3xl font-bold text-blue-600"><%= calculate_profile_completion(@recruiter) %>%</div>
      <%= progress_bar(calculate_profile_completion(@recruiter), color: "blue") %>
      <p class="mt-2 text-sm text-gray-600">Complete your profile to improve visibility to students</p>
    </div>
    
    <div class="card p-4 border rounded-lg shadow-md bg-white">
      <h2 class="text-lg font-semibold mb-2 text-blue-700">Company Info</h2>
      <div class="space-y-2">
        <div class="flex justify-between items-center">
          <span class="text-gray-600">Company Name:</span>
          <span class="font-semibold"><%= @analytics_data[:company_info][:company_name] || "Not provided" %></span>
        </div>
        <div class="flex justify-between items-center">
          <span class="text-gray-600">Industry:</span>
          <span class="font-semibold"><%= @analytics_data[:company_info][:industry] || "Not provided" %></span>
        </div>
        <div class="flex justify-between items-center">
          <span class="text-gray-600">Employees:</span>
          <span class="font-semibold"><%= @analytics_data[:company_info][:employee_count] || "Not provided" %></span>
        </div>
      </div>
    </div>
    
    <div class="card p-4 border rounded-lg shadow-md bg-white">
      <h2 class="text-lg font-semibold mb-2 text-blue-700">Potential Matches</h2>
      <div class="text-3xl font-bold text-blue-600"><%= @analytics_data[:potential_matches] %></div>
      <p class="mt-2 text-sm text-gray-600">Students with skills matching your industry</p>
    </div>
  </div>
  
  <!-- Industry Position -->
  <% if @analytics_data[:company_industry_position] && @analytics_data[:company_industry_position][:industry].present? %>
    <div class="card p-4 border rounded-lg shadow-md bg-white">
      <h2 class="text-lg font-semibold mb-4 text-blue-700">Industry Position</h2>
      <div class="flex items-center">
        <div class="w-1/3 text-center p-4">
          <div class="text-5xl font-bold text-blue-700">
            <%= @analytics_data[:company_industry_position][:similar_recruiters] %>
          </div>
          <p class="text-sm text-gray-600 mt-2">Other Companies<br>in <%= @analytics_data[:company_industry_position][:industry] %></p>
        </div>
        
        <div class="w-1/3 text-center border-l border-r border-gray-200 p-4">
          <div class="text-3xl font-bold text-gray-800">
            <%= ((@analytics_data[:company_industry_position][:similar_recruiters].to_f / @analytics_data[:company_industry_position][:total_recruiters]) * 100).round %>%
          </div>
          <p class="text-sm text-gray-600 mt-2">Of Total<br>Companies</p>
        </div>
        
        <div class="w-1/3 text-center p-4">
          <div class="text-5xl font-bold text-gray-700">
            <%= @analytics_data[:company_industry_position][:total_recruiters] %>
          </div>
          <p class="text-sm text-gray-600 mt-2">Total<br>Companies</p>
        </div>
      </div>
    </div>
  <% end %>
  
  <!-- Industry Distribution -->
  <div class="card p-4 border rounded-lg shadow-md bg-white">
    <h2 class="text-lg font-semibold mb-4 text-blue-700">Industry Distribution</h2>
    <% if @industry_data[:values].any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <canvas id="industry-distribution-chart" height="250"
            data-industries="<%= { labels: @industry_data[:labels], values: @industry_data[:values] }.to_json %>"></canvas>
        </div>
        
        <div class="self-center">
          <h3 class="font-medium text-gray-800 mb-3">Industry Breakdown</h3>
          <div class="space-y-3">
            <% @industry_data[:labels].each_with_index do |industry, i| %>
              <div class="flex justify-between">
                <span class="text-sm"><%= industry %></span>
                <span class="text-sm font-semibold"><%= @industry_data[:values][i] %> companies</span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-1.5">
                <div class="h-1.5 rounded-full" style="width: <%= (@industry_data[:values][i].to_f / @industry_data[:values].sum * 100).round %>%; background-color: <%= ['#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#ec4899', '#c7c7c7'][i % 7] %>"></div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% else %>
      <p class="text-gray-500 italic">No industry data available.</p>
    <% end %>
  </div>
  
  <!-- Student Skills Distribution -->
  <div class="card p-4 border rounded-lg shadow-md bg-white">
    <h2 class="text-lg font-semibold mb-4 text-blue-700">Top Student Skills</h2>
    <% 
      top_skills = top_skills_data(8)
      industry = @analytics_data[:company_info][:industry]
      
      relevant_skills = if industry.present?
        # Simple relevance check (would be more sophisticated in a real app)
        top_skills[:labels].map.with_index do |skill, i|
          {
            name: skill,
            count: top_skills[:values][i],
            relevant: skill.downcase.include?(industry.downcase) || industry.downcase.include?(skill.downcase)
          }
        end
      else
        top_skills[:labels].map.with_index do |skill, i|
          {
            name: skill,
            count: top_skills[:values][i],
            relevant: false
          }
        end
      end
    %>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3">
      <% relevant_skills.each do |skill| %>
        <div class="p-3 rounded-lg <%= skill[:relevant] ? 'bg-green-50 border border-green-200' : 'bg-gray-50 border border-gray-200' %>">
          <div class="flex justify-between items-center">
            <span class="font-medium <%= skill[:relevant] ? 'text-green-700' : 'text-gray-700' %>">
              <%= skill[:name] %>
            </span>
            <% if skill[:relevant] %>
              <span class="text-xs px-2 py-0.5 bg-green-100 text-green-800 rounded-full">Relevant</span>
            <% end %>
          </div>
          <div class="text-sm text-gray-500 mt-1">
            Found in <%= skill[:count] %> student <%= "profile".pluralize(skill[:count]) %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
  
  <!-- Recommendations -->
  <div class="card p-4 border rounded-lg shadow-md bg-white">
    <h2 class="text-lg font-semibold mb-4 text-blue-700">Recommendations</h2>
    
    <div class="space-y-4">
      <% completion = calculate_profile_completion(@recruiter) %>
      <% if completion < 100 %>
        <div class="p-3 bg-blue-50 border border-blue-200 rounded-lg">
          <h3 class="font-medium text-blue-700 mb-1">Complete Your Profile</h3>
          <p class="text-sm text-gray-700">Your profile is <%= completion %>% complete. Completing your profile helps students find your company more easily.</p>
        </div>
      <% end %>
      
      <% if @analytics_data[:company_info][:industry].blank? %>
        <div class="p-3 bg-yellow-50 border border-yellow-200 rounded-lg">
          <h3 class="font-medium text-yellow-700 mb-1">Add Your Industry</h3>
          <p class="text-sm text-gray-700">Specifying your industry helps match your company with students who have relevant skills.</p>
        </div>
      <% end %>
      
      <div class="p-3 bg-green-50 border border-green-200 rounded-lg">
        <h3 class="font-medium text-green-700 mb-1">Student Outreach</h3>
        <p class="text-sm text-gray-700">Based on your industry, there are <%= @analytics_data[:potential_matches] %> students with matching skills who could be good candidates for your company.</p>
      </div>
    </div>
  </div>
  
  <script>
    document.addEventListener('turbo:load', function() {
      // Initialize Industry Distribution Chart
      const industryChartCanvas = document.getElementById('industry-distribution-chart');
      if (industryChartCanvas) {
        const industryData = JSON.parse(industryChartCanvas.dataset.industries);
        new Chart(industryChartCanvas, {
          type: 'pie',
          data: {
            labels: industryData.labels,
            datasets: [{
              data: industryData.values,
              backgroundColor: [
                'rgba(59, 130, 246, 0.6)',
                'rgba(16, 185, 129, 0.6)',
                'rgba(245, 158, 11, 0.6)',
                'rgba(239, 68, 68, 0.6)',
                'rgba(139, 92, 246, 0.6)',
                'rgba(236, 72, 153, 0.6)',
                'rgba(199, 199, 199, 0.6)'
              ],
              borderWidth: 1
            }]
          },
          options: {
            responsive: true,
            plugins: {
              legend: {
                position: 'right',
              },
              title: {
                display: true,
                text: 'Companies by Industry'
              }
            }
          }
        });
      }
    });
  </script>
</div> 