<body class="bg-gradient-to-r from-blue-50 to-purple-50">
  <div class="flex flex-col lg:flex-row h-screen">
    <!-- Left Section (Welcome Message) -->
    <div class="lg:w-1/2 w-full bg-gradient-to-r from-blue-600 to-purple-600 text-white flex justify-center items-center p-10">
      <div class="text-center">
        <h1 class="text-4xl font-bold mb-4">Welcome to Our Platform</h1>
        <p class="text-lg">Join us to explore opportunities and grow your career.</p>
      </div>
    </div>

    <!-- Right Section (Signup Form) -->
    <div class="lg:w-1/2 w-full bg-white flex justify-center items-center p-8">
      <div class="w-full max-w-md">
        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { id: 'signupForm', onsubmit: 'return validateForm()', class: 'bg-white shadow-lg rounded-lg px-8 pt-6 pb-8 mb-4' }) do |f| %>
          <h2 class="text-3xl font-bold text-gray-800 text-center mb-8">Create Your Account</h2>

          <!-- User Type Dropdown -->
          <div class="mb-6">
            <%= f.label :user_type, "User Type", class: "block text-gray-700 text-sm font-bold mb-2" %>
            <%= f.select :user_type, [["Student", "student"], ["Recruiter", "recruiter"], ["Career Office", "career_office"]], {}, { class: "w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500", onchange: "toggleFields()" } %>
          </div>

          <!-- Full Name Field -->
          <div class="mb-6">
            <%= f.label :full_name, class: "block text-gray-700 text-sm font-bold mb-2" %>
            <%= f.text_field :full_name, placeholder: 'Enter your full name', class: "w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          </div>

          <!-- Email Field -->
          <div class="mb-6">
            <%= f.label :email, "Institutional/Organizational Email", class: "block text-gray-700 text-sm font-bold mb-2" %>
            <%= f.email_field :email, placeholder: 'example@domain.com', class: "w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          </div>

          <!-- Student Fields -->
          <div id="studentFields" class="mt-6" style="display: none;">
            <%= f.fields_for :student_profile, StudentProfile.new do |student_form| %>
              <div class="mb-6">
                <%= student_form.label :email_personal, "Personal Email", class: "block text-gray-700 text-sm font-bold mb-2" %>
                <%= student_form.text_field :email_personal, placeholder: 'example@gmail.com', class: "w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
              </div>
            <% end %>
          </div>

          <!-- Recruiter Fields -->
          <div id="recruiterFields" class="mt-6" style="display: none;">
            <%= f.fields_for :recruiter_profile, RecruiterProfile.new do |recruiter_form| %>
              <div class="mb-6">
                <%= recruiter_form.label :company_name, class: "block text-gray-700 text-sm font-bold mb-2" %>
                <%= recruiter_form.text_field :company_name, placeholder: 'Enter company name', class: "w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
              </div>
            <% end %>
          </div>

          <!-- Career Office Fields -->
          <div id="careerOfficeFields" class="mt-6" style="display: none;">
            <%= f.fields_for :career_officer_profile, CareerOfficerProfile.new do |career_form| %>
              <div class="mb-6">
                <%= career_form.label :designation, class: "block text-gray-700 text-sm font-bold mb-2" %>
                <%= career_form.text_field :designation, placeholder: 'Enter your designation', class: "w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
              </div>
            <% end %>
          </div>

          <!-- Password Field -->
          <div class="mb-6">
            <%= f.label :password, class: "block text-gray-700 text-sm font-bold mb-2" %>
            <%= f.password_field :password, placeholder: 'Enter your password', class: "w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          </div>

          <!-- Submit Button -->
          <div class="mb-6">
            <%= f.submit "Sign Up", class: 'w-full bg-blue-600 text-white font-bold py-3 rounded-lg hover:bg-blue-700 transition-all cursor-pointer' %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <script>
    function toggleFields() {
      const userType = document.getElementById("user_user_type").value;
      document.getElementById("studentFields").style.display = "none";
      document.getElementById("recruiterFields").style.display = "none";
      document.getElementById("careerOfficeFields").style.display = "none";
      
      if (userType === "student") {
        document.getElementById("studentFields").style.display = "block";
      } else if (userType === "recruiter") {
        document.getElementById("recruiterFields").style.display = "block";
      } else if (userType === "career_office") {
        document.getElementById("careerOfficeFields").style.display = "block";
      }
    }
    
    window.onload = function() {
      toggleFields();
    }
  </script>
</body>