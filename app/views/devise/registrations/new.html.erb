<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dynamic Signup Page</title>
</head>
<body class="bg-gray-100">
  <div class="flex flex-col lg:flex-row h-screen">
    <div class="lg:w-1/2 w-full bg-blue-500 text-white flex justify-center items-center p-10">
      <h1 class="text-2xl font-bold">Welcome to Our Platform</h1>
    </div>

    <div class="lg:w-1/2 w-full bg-white flex justify-center items-center p-6">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { id: 'signupForm', onsubmit: 'return validateForm()' }) do |f| %>
        <h2 class="text-3xl font-bold text-gray-800 text-center mb-8">Create Your Account</h2>

        <div class="mb-6">
          <%= f.label :user_type, "User Type" %>
          <%= f.select :user_type, [["Student", "student"], ["Recruiter", "recruiter"], ["Career Office", "career_office"]], {}, onchange: "toggleFields()" %>
        </div>

        <div class="mb-6">
          <%= f.label :full_name %>
          <%= f.text_field :full_name, placeholder: 'Enter your full name' %>
        </div>

        <div class="mb-6">
          <%= f.label :email %>
          <%= f.email_field :email, placeholder: 'example@domain.com' %>
        </div>

        <div class="mb-6">
          <%= f.label :password %>
          <%= f.password_field :password, placeholder: 'Enter your password' %>
        </div>
      <!-- Phone Number -->
        <div class="mb-6">
          <%= f.label :phone_number, class: 'block text-gray-700 text-sm font-bold mb-2' %>
          <%= f.text_field :phone_number, 
              placeholder: '03XX-XXXXXXX', 
              class: 'w-full px-4 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500', 
              id: "user_phone_number",
              required: true 
          %>
          <p id="phoneNumberError" class="text-red-500 text-sm mt-2"></p>
        </div>

        <div id="studentFields" class="mt-6" style="display: none;">
          <%= f.fields_for :profile, Student.new do |student_form| %>
            <div class="mb-6">
              <%= student_form.label :roll_number %>
              <%= student_form.text_field :roll_number, placeholder: 'Roll Number i.e (17L-1234)' %>
            </div>
          <% end %>
        </div>

        <div id="recruiterFields" class="mt-6" style="display: none;">
          <%= f.fields_for :profile, Recruiter.new do |recruiter_form| %>
            <div class="mb-6">
              <%= recruiter_form.label :company_name %>
              <%= recruiter_form.text_field :company_name, placeholder: 'Enter company name' %>
            </div>
          <% end %>
        </div>

        <div id="careerOfficeFields" class="mt-6" style="display: none;">
          <%= f.fields_for :profile, CareerOffice.new do |career_form| %>
            <div class="mb-6">
              <%= career_form.label :institution_name %>
              <%= career_form.text_field :institution_name, placeholder: 'Enter institution name' %>
            </div>
          <% end %>
        </div>

        <%= f.submit "Sign Up", class: 'w-full bg-blue-500 text-white font-bold py-3 rounded-md hover:bg-blue-600 transition-all' %>
      <% end %>
    </div>
  </div>

  <script>
    function toggleFields() {
      const userType = document.getElementById("user_user_type").value;
      document.getElementById("studentFields").style.display = "none";
      document.getElementById("recruiterFields").style.display = "none";
      document.getElementById("careerOfficeFields").style.display = "none";
      
      if (userType === "student") {
        document.getElementById("studentFields").style.display = "block";
      } else if (userType === "recruiter") {
        document.getElementById("recruiterFields").style.display = "block";
      } else if (userType === "career_office") {
        document.getElementById("careerOfficeFields").style.display = "block";
      }
    }
    
    window.onload = function() {
      toggleFields();
    }
  </script>
</body>
</html>