<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign Up</title>
</head>
<body class="bg-[#0F6DB5]">
  
  <!-- Header -->
  <nav class="absolute top-0 left-0 right-0 z-10 bg-[#0F6DB5]">
    <div class="mx-auto max-w-7xl px-6 lg:px-12">
      <div class="flex items-center justify-between py-5 text-white">
        <div class="flex items-center gap-8">
          <img src="<%= asset_path('logo') %>" alt="Fast Nuces Logo" style="height: 44px; width: auto;">
          <div class="hidden md:flex items-center gap-7 text-sm font-medium text-white/90">
            <%= link_to 'Home', root_path, class: 'hover:text-white transition-colors' %>
            <%= link_to 'How It Works', '#how-it-works', class: 'hover:text-white transition-colors' %>
            <%= link_to 'Contact', '#footer', class: 'hover:text-white transition-colors' %>
          </div>
        </div>
        <div class="flex items-center gap-3 text-sm">
          <%= link_to 'Log in', new_user_session_path , class: 'px-4 py-2 border border-white/70 rounded-full hover:border-white hover:bg-white/10 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70' %>
          <%= link_to 'Sign up', new_user_registration_path , class: 'px-4 py-2 rounded-full bg-white text-[#0F6DB5] font-semibold hover:bg-white/90 transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70' %>
        </div>
      </div>
    </div>
  </nav>

<!-- Main Container -->
  <div class="flex flex-col lg:flex-row min-h-screen">
    <!-- Left Section (Welcome Message) -->
    <div class="lg:w-1/2 w-full bg-blue-500 text-white flex justify-center items-center px-12 pt-24 pb-12">
      <div class="text-center">
        <h1 class="text-4xl font-extrabold mb-6">Welcome to Our Platform</h1>
        <p class="text-lg mb-6">Join us to explore opportunities and grow your career.</p>
        <a href="#" class="mt-8 text-base underline hover:text-gray-200 block">Learn More</a>
      </div>
    </div>

    <!-- Right Section (Signup Form) -->
    <div class="lg:w-1/2 w-full bg-white flex justify-center items-center px-12 pt-24 pb-12">

      <div class="w-full max-w-md">
        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { id: 'signupForm', class: 'bg-gray-50 shadow-lg rounded-lg px-8 pt-6 pb-8 mb-4', data: { controller: "toggle-fields" }, onsubmit: "return validateForm()" }) do |f| %>
          <h2 class="text-3xl font-bold text-gray-800 text-center mb-8">Create Your Account</h2>

          <!-- User Type Dropdown -->
                                        <!-- Add this for the career_officer field inisde Drop down  <%# ["Career Officer", "career_officer"] %>-->
   <div class="mb-6">
  <%= f.label :user_type, "User Type", class: "block text-gray-700 text-sm font-bold mb-2" %>
  <%= f.select :user_type, 
      options_for_select([
        ["Student", "student"],
        ["Recruiter", "recruiter"]
      ], ""), 
      { include_blank: "Select User Type" }, 
      { 
        id: 'user_type',
        class: "w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500", 
        data: { toggle_fields_target: "userType" },
        "data-action": "change->toggle-fields#toggle",
        required: true 
      } %>
</div>
          <!-- Full Name Field -->
          <div class="mb-6">
            <%= f.label :full_name, class: "block text-gray-700 text-sm font-bold mb-2" %>
            <%= f.text_field :full_name, id: 'user_full_name', placeholder: 'John Doe', class: "w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500", required: true %>
          </div>

          <!-- Email Field -->
          <!-- Email Field -->
<div class="mb-6">
  <%= f.label :email, "Institutional/Organizational Email", class: "block text-gray-700 text-sm font-bold mb-2" %>
  <%= f.email_field :email, id: 'user_email', placeholder: 'john.doe@university.edu', class: "w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500", required: true %>
  <p id="emailError" class="text-red-500 text-sm mt-2 hidden"></p>
  <!-- Display server-side validation errors -->
  <% if resource.errors[:email].any? %>
    <p class="text-red-500 text-sm mt-2"><%= resource.errors[:email].join(", ") %></p>
  <% end %>
</div>

         <!-- Student Fields -->
<div id="studentFields" class="mt-6" style="display: none;" data-toggle-fields-target="studentFields">
  <%= f.fields_for :student_profile, resource.student_profile || StudentProfile.new do |student_form| %>
    <div class="mb-6">
      <%= student_form.label :email_personal, "Personal Email", class: "block text-gray-700 text-sm font-bold mb-2" %>
      <%= student_form.text_field :email_personal, id: 'user_email_personal', placeholder: 'john.doe@gmail.com', class: "w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      <p id="personalEmailError" class="text-red-500 text-sm mt-2 hidden"></p>
      <!-- Display server-side validation errors -->
      <% if resource.student_profile&.errors&.[](:email_personal)&.any? %>
        <p class="text-red-500 text-sm mt-2"><%= resource.student_profile.errors[:email_personal].join(", ") %></p>
      <% end %>
    </div>
  <% end %>
</div>
          <!-- Recruiter Fields -->
          <div id="recruiterFields" class="mt-6" style="display: none;" data-toggle-fields-target="recruiterFields">
            <%= f.fields_for :recruiter_profile, RecruiterProfile.new do |recruiter_form| %>
              <div class="mb-6">
                <%= recruiter_form.label :company_name, class: "block text-gray-700 text-sm font-bold mb-2" %>
                <%= recruiter_form.text_field :company_name, id: 'user_company_name', placeholder: 'Acme Corporation', class: "w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
              </div>
            <% end %>
          </div>

          <!-- Career Office Fields -->
          <div id="careerOfficerFields" class="mt-6" style="display: none;" data-toggle-fields-target="careerOfficerFields">
            <%= f.fields_for :career_officer_profile, CareerOfficerProfile.new do |career_form| %>
              <div class="mb-6">
                <%= career_form.label :designation, class: "block text-gray-700 text-sm font-bold mb-2" %>
                <%= career_form.text_field :designation, id: 'user_designation', placeholder: 'Career Advisor', class: "w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
              </div>
            <% end %>
          </div>

          <!-- Password Field -->
          <div class="mb-6">
            <%= f.label :password, class: "block text-gray-700 text-sm font-bold mb-2" %>
            <%= f.password_field :password, id: 'user_password', placeholder: 'Create a strong password (min. 8 characters)', class: "w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500", required: true, minlength: 8 %>
          </div>

          <!-- Confirm Password Field -->
          <div class="mb-6">
            <%= f.label :password_confirmation, "Confirm Password", class: "block text-gray-700 text-sm font-bold mb-2" %>
            <%= f.password_field :password_confirmation, id: 'user_password_confirmation', placeholder: 'Re-enter your password', class: "w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500", required: true, minlength: 8 %>
            <p id="passwordError" class="text-red-500 text-sm mt-2 hidden">Passwords do not match.</p>
          </div>

          <!-- Submit Button -->
          <div class="mb-6">
            <%= f.submit "Sign Up", class: "w-full bg-blue-500 text-white font-bold py-2 px-4 rounded hover:bg-blue-600 transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400" %>
        <% end %>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const userTypeDropdown = document.getElementById("user_type");
      const studentFields = document.getElementById("studentFields");
      const recruiterFields = document.getElementById("recruiterFields");
      const careerOfficerFields = document.getElementById("careerOfficerFields");

      // Function to toggle fields based on user type
      function toggleFields() {
        const selectedUserType = userTypeDropdown.value;

        // Hide all fields initially
        studentFields.style.display = "none";
        recruiterFields.style.display = "none";
        careerOfficerFields.style.display = "none";

        // Show fields based on selected user type
        if (selectedUserType === "student") {
          studentFields.style.display = "block";
        } else if (selectedUserType === "recruiter") {
          recruiterFields.style.display = "block";
        } else if (selectedUserType === "career_officer") {
          careerOfficerFields.style.display = "block";
        }
      }

      // Add event listener to the dropdown
      userTypeDropdown.addEventListener("change", toggleFields);

      // Trigger the toggle function on page load (in case a user type is pre-selected)
      toggleFields();
    });

   function validateForm() {
  const userType = document.getElementById("user_type").value;
  const email = document.getElementById("user_email").value;
  const personalEmail = document.getElementById("user_email_personal")?.value; // Optional chaining for personal email
  const password = document.getElementById("user_password").value;
  const confirmPassword = document.getElementById("user_password_confirmation").value;
  const passwordError = document.getElementById("passwordError");
  const emailError = document.getElementById("emailError");
  const personalEmailError = document.getElementById("personalEmailError");

  // Store selected user type in session storage
  sessionStorage.setItem("selectedUserType", userType);

  // Password matching validation
  if (password !== confirmPassword) {
    passwordError.classList.remove("hidden");
    return false; // Prevent form submission
  } else {
    passwordError.classList.add("hidden");
  }

  // Email domain validation for students and career officers
  if (userType === "student" || userType === "career_officer") {
    if (!email.endsWith("@cfd.nu.edu.pk")) {
      emailError.textContent = "Email must be a valid @cfd.nu.edu.pk email address.";
      emailError.classList.remove("hidden");
      return false; // Prevent form submission
    } else {
      emailError.classList.add("hidden");
    }
  }

  // Personal email validation for students
  if (userType === "student" && personalEmail) {
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/; // Basic email format validation
    if (!emailRegex.test(personalEmail)) {
      personalEmailError.textContent = "Personal email must be a valid email address.";
      personalEmailError.classList.remove("hidden");
      return false; // Prevent form submission
    } else {
      personalEmailError.classList.add("hidden");
    }
  }

  return true; // Allow form submission
}

// This event listener should be outside the validateForm function
document.addEventListener("DOMContentLoaded", function() {
  // Restore user type selection if it exists in session storage
  const savedUserType = sessionStorage.getItem("selectedUserType");
  if (savedUserType) {
    document.getElementById("user_type").value = savedUserType;
    // Trigger the change event to update visible fields
    document.getElementById("user_type").dispatchEvent(new Event('change'));
  }
});
  </script>
</body>
</html>