<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
</head>
<body class="bg-[#0F6DB5]">
    <!-- Header -->
    <nav class="absolute top-0 left-0 right-0 z-10 bg-[#0F6DB5]">
        <div class="mx-auto max-w-7xl px-6 lg:px-12">
            <div class="flex items-center justify-between py-5 text-white">
                <div class="flex items-center gap-8">
                    <img src="<%= asset_path('logo') %>" alt="Fast Nuces Logo" style="height: 44px; width: auto;">
                    <div class="hidden md:flex items-center gap-7 text-sm font-medium text-white/90">
                        <%= link_to 'Home', root_path, class: 'hover:text-white transition-colors' %>
                        <%= link_to 'How It Works', '#how-it-works', class: 'hover:text-white transition-colors' %>
                        <%= link_to 'Contact', '#footer', class: 'hover:text-white transition-colors' %>
                    </div>
                </div>
                <div class="flex items-center gap-3 text-sm">
                    <%= link_to 'Log in', new_user_session_path , class: 'px-4 py-2 border border-white/70 rounded-full hover:border-white hover:bg-white/10 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70' %>
                    <%= link_to 'Sign up', new_user_registration_path , class: 'px-4 py-2 rounded-full bg-white text-[#0F6DB5] font-semibold hover:bg-white/90 transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70' %>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Container -->
    <div class="flex flex-col lg:flex-row min-h-screen">
        <!-- Left Section -->
        <div class="lg:w-1/2 w-full bg-blue-500 text-white flex justify-center items-center px-12 pt-24 pb-12">
            <div class="text-center">
                <h1 class="text-4xl font-extrabold mb-6">Get the job done</h1>
                <div class="space-y-6">
                    <div>
                        <p class="text-xl font-bold">Student</p>
                        <p class="text-base">Launch the next step in your career.</p>
                    </div>
                    <div>
                        <p class="text-xl font-bold">Employers</p>
                        <p class="text-base">Hire the next generation of talent.</p>
                    </div>
                    <div>
                        <p class="text-xl font-bold">Career Centers</p>
                        <p class="text-base">Bring the best jobs to your students.</p>
                    </div>
                </div>
                <a href="#" class="mt-8 text-base underline hover:text-gray-200 block">Learn More</a>
            </div>
        </div>

        <!-- Right Section -->
        <div class="lg:w-1/2 w-full bg-white flex justify-center items-center px-12 pt-24 pb-12">
            <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: 'w-full max-w-sm bg-gray-50 p-6 rounded-lg shadow-lg' }) do |f| %>
                <h2 class="text-2xl font-semibold mb-6 text-center">Login</h2>

                <!-- Email Field -->
                <div class="mb-4">
                    <%= f.label :email, "Email", class: 'block text-gray-700 text-sm font-bold mb-2' %>
                    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500", placeholder: "example@university.edu" %>
                </div>

                <!-- Password Field -->
                <div class="mb-4">
                    <%= f.label :password, "Password", class: 'block text-gray-700 text-sm font-bold mb-2' %>
                    <%= f.password_field :password, autocomplete: "current-password", class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500", placeholder: "••••••••" %>
                </div>

                <!-- Remember Me Checkbox -->
                <% if devise_mapping.rememberable? %>
                    <div class="flex items-center mb-4">
                        <%= f.check_box :remember_me, class: 'mr-2' %>
                        <%= f.label :remember_me, "Remember Me", class: 'text-sm text-gray-600' %>
                    </div>
                <% end %>

                <!-- Forgot Password -->
                <div class="mb-4">
                    <a href="<%= new_user_password_path %>" class="text-sm text-blue-500 hover:underline">Forgot Password?</a>
                </div>

                <!-- Submit Button -->
                <div>
                    <%= f.submit 'Login', class: "w-full bg-blue-500 text-white font-bold py-2 px-4 rounded hover:bg-blue-600 transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400" %>
                </div>

                <div class="mt-6">
                    <p class="text-sm text-center text-gray-600">By logging in, you agree to our <a href="#" class="text-blue-500 hover:underline">Terms & Conditions</a>.</p>
                </div>
            <% end %>
        </div>
    </div>
</body>
</html>
