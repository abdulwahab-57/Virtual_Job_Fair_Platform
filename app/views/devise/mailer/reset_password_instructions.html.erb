<!DOCTYPE html>
<html>
  <head>
    <style>
      /* Overall styling for the email */
      body {
        font-family: Arial, sans-serif;
        color: #333;
        line-height: 1.6;
        margin: 0;
        padding: 0;
      }

      .email-container {
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
        background-color: #f9f9f9;
        padding: 20px;
        border-radius: 10px;
        border: 1px solid #ddd;
      }

      .header {
        text-align: center;
        padding: 20px;
        background-color: #1a73e8; /* Blue header background */
        border-radius: 10px 10px 0 0;
        color: #fff;
        font-size: 24px;
      }

      .content {
        padding: 20px;
        text-align: left;
        font-size: 16px;
      }

      .button-container {
        text-align: center;
        margin: 20px 0;
      }

      .button {
        background-color: #1a73e8; /* Blue button background */
        color: white; /* Text color set to white */
        text-decoration: none;
        font-size: 18px;
        padding: 12px 20px;
        border-radius: 5px;
        display: inline-block;
        transition: background-color 0.3s ease;
        font-weight: bold;
      }

      .button:hover {
        background-color: #1558b2; /* Darker blue on hover */
      }

      .footer {
        text-align: center;
        margin-top: 20px;
        font-size: 14px;
        color: #888;
      }

      a {
        color: #1a73e8; /* Blue link color */
      }
    </style>
  </head>
  <body>
    <div class="email-container">
      <!-- Header -->
      <div class="header">
        Get the Job Done
      </div>

      <!-- Content -->
      <div class="content">
        <p>Hi <strong><%= @resource.email %></strong>,</p>
        <p>
          We received a request to reset your password for your account on
          <strong>Virtual Job Fair Platform</strong>. If you made this request, please click the button below to reset your password:
        </p>

        <!-- Button -->
        <div class="button-container">
          <a href="<%= edit_password_url(@resource, reset_password_token: @token) %>" class="button">
            Change my password
          </a>
        </div>

        <p>
          If you did not request a password reset, you can safely ignore this email. Your account is safe, and no changes will be made.
        </p>

        <p>
          If you have any questions, feel free to contact our support team at
          <a href="mailto:support@virtualjobfair.com">support@virtualjobfair.com</a>.
        </p>
      </div>

      <!-- Footer -->
      <div class="footer">
        &copy; 2024 Virtual Job Fair Platform. All rights reserved.
      </div>
    </div>
  </body>
</html>
