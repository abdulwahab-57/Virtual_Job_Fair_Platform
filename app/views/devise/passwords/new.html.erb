<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Your Password?</title>
</head>
<body class="bg-gray-100">
    
    <!-- Header -->
    <div style="position: absolute; top: 1rem; right: 1.5rem; z-index: 10;">
        <p style="white-space: nowrap; font-size: 0.875rem; color: #4b5563;">
            Remembered your password? <a href="<%= new_user_session_path %>" style="color: #2563eb; font-weight: 600; text-decoration: underline;">Login here</a>
        </p>
    </div>

    <!-- Main Container -->
    <div class="flex flex-col lg:flex-row h-screen">
        <!-- Left Section -->
        <div class="lg:w-1/2 w-full bg-blue-500 text-white flex justify-center items-center p-12">
            <div class="text-center">
                <h1 class="text-4xl font-extrabold mb-6">Reset Your Password</h1>
                <p class="text-xl">Enter your email to receive password reset instructions.</p>
            </div>
        </div>

        <!-- Right Section (Form) -->
        <div class="lg:w-1/2 w-full bg-white flex justify-center items-center p-12">
            <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: 'w-full max-w-sm bg-gray-50 p-6 rounded-lg shadow-lg' }) do |f| %>
                <h2 class="text-2xl font-semibold mb-6 text-center">Forgot your password?</h2>
                
                <!-- Error Messages -->
                <% if resource.errors.any? %>
                  <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
                    <p class="font-bold">Oops! There was a problem:</p>
                    <ul class="list-disc pl-5 mt-2">
                      <% resource.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                      <% end %>
                    </ul>
                  </div>
                <% end %>

                <!-- Email Field -->
                <div class="mb-4">
                    <%= f.label :email, "Email", class: 'block text-gray-700 text-sm font-bold mb-2' %>
                    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500", placeholder: "example@university.edu" %>
                </div>

                <!-- Submit Button -->
                <div>
                    <%= f.submit "Send me reset password instructions", class: "w-full bg-blue-500 text-white font-bold py-2 px-4 rounded hover:bg-blue-600" %>
                </div>
            <% end %>
        </div>
    </div>
</body>
</html>