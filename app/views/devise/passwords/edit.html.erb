<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change Your Password</title>
    <script>
        // Function to validate password confirmation
        function validatePassword() {
            const password = document.getElementById("user_password").value;
            const confirmPassword = document.getElementById("user_password_confirmation").value;
            const errorElement = document.getElementById("passwordError");

            if (password !== confirmPassword) {
                errorElement.textContent = "Passwords do not match!";
                return false;
            } else {
                errorElement.textContent = "";
                return true;
            }
        }
    </script>
</head>
<body class="bg-gray-100">
    <!-- Header -->
    <div class="absolute top-4 right-6">
        <p class="text-sm text-gray-600">Remembered your password? <a href="<%= new_user_session_path %>" class="text-blue-500 font-semibold hover:underline">Login here</a></p>
    </div>

    <!-- Main Container -->
    <div class="flex flex-col lg:flex-row h-screen">
        <!-- Left Section -->
        <div class="lg:w-1/2 w-full bg-blue-500 text-white flex justify-center items-center p-12">
            <div class="text-center">
                <h1 class="text-4xl font-extrabold mb-6">Change Your Password</h1>
                <p class="text-xl">Enter your new password below to reset it.</p>
            </div>
        </div>

        <!-- Right Section (Form) -->
        <div class="lg:w-1/2 w-full bg-white flex justify-center items-center p-12">
            <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: 'w-full max-w-sm bg-gray-50 p-6 rounded-lg shadow-lg', onsubmit: 'return validatePassword()' }) do |f| %>
                <h2 class="text-2xl font-semibold mb-6 text-center">Change your password</h2>

                <!-- Error Messages -->
                <%= render "devise/shared/error_messages", resource: resource %>
                <%= f.hidden_field :reset_password_token %>

                <!-- New Password Field -->
                <div class="mb-4">
                    <%= f.label :password, "New password", class: 'block text-gray-700 text-sm font-bold mb-2' %>
                    <% if @minimum_password_length %>
                        <em class="text-gray-500">(<%= @minimum_password_length %> characters minimum)</em><br />
                    <% end %>
                    <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500", id: "user_password", placeholder: "Enter new password" %>
                </div>

                <!-- Confirm Password Field -->
                <div class="mb-4">
                    <%= f.label :password_confirmation, "Confirm new password", class: 'block text-gray-700 text-sm font-bold mb-2' %>
                    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500", id: "user_password_confirmation", placeholder: "Re-enter your new password" %>
                    <p id="passwordError" class="text-red-500 text-sm mt-2"></p>
                </div>

                <!-- Submit Button -->
                <div class="mb-4">
                    <%= f.submit "Change my password", class: "w-full bg-blue-500 text-white font-bold py-2 px-4 rounded hover:bg-blue-600" %>
                </div>
            <% end %>

            <!-- Links (Render login/signup links if necessary) -->
            <div class="mt-6 text-center">
              <!--  <%  "devise/shared/links" %> -->
            </div>
        </div>
    </div>
</body>
</html>
