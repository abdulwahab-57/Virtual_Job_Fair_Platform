        <div class="flex-1 flex flex-col py-8 gap-8">
            <div class="flex">
                <div class="flex-1">
                    <h1 class="text-[32px] font-bold text-[#333333]"><%= @user.recruiter_profile.company_name %></h1>
                    <h2 class="text-base text-[#AAAAAA]"><%= @user.recruiter_profile.industry %></h2>
                </div>
                <%= link_to @edit_profile_path, class: 'self-start text-center py-2 px-4 bg-[#1499DC] hover:bg-[#0d7bbd] rounded-md' do %>
                    <div class="flex gap-2">
                        <svg width="12" height="13" viewBox="0 0 12 13" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path
                                d="M9.7352 0.5C9.57359 0.5 9.41181 0.561559 9.28865 0.685033L8.21053 1.76316L10.7368 4.28947L11.815 3.21135C12.0619 2.9644 12.0619 2.56457 11.815 2.31826L10.1817 0.685033C10.0583 0.561559 9.8968 0.5 9.7352 0.5ZM7.26316 2.71053L1.26316 8.71053C1.26316 8.71053 1.89789 8.71368 2.21053 9.02632C2.52316 9.33895 2.51645 9.96382 2.51645 9.96382C2.51645 9.96382 3.16042 9.97621 3.47368 10.2895C3.78695 10.6027 3.78947 11.2368 3.78947 11.2368L9.78947 5.23684L7.26316 2.71053ZM0.423109 9.97368L0 12.5L2.52632 12.0769L0.423109 9.97368Z"
