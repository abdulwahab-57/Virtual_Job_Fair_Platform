                        </svg>
                        <span class="text-white text-xs font-medium">Edit Profile</span>
                    </div>
                <% end %>
            </div>
            <div class="flex flex-col gap-6 text-justify">
                <div class="flex flex-col gap-3">
                    <h1 class="text-2xl font-semibold text-[#333333]">About Company</h1>
                    <p class="text-base text-[#333333]">
                        <%= @user.recruiter_profile.about_company %>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>       