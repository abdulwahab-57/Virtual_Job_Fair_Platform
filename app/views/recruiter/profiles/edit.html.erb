<div class="flex items-center justify-center">
    <%= form_with(model: @user.recruiter_profile, url: recruiter_profile_path(@user.id), method: :put, class: "py-8 px-10 w-[720px] flex flex-col gap-3 bg-white") do |f| %>
        <div class="flex flex-col gap-[2px]">
            <%= f.label :company_name, "Company Name", class: "text-[#333333] text-base font-normal" %>
            <%= f.text_field :company_name, class: 'p-3 transition-colors focus:text-[#333333] text-[#333333]/50 font-normal border-b border-[#BBBDD1] rounded-md' %>
        </div>

        <div class="flex flex-col gap-[2px]">
            <%= f.label :industry, "Industry", class: "text-[#333333] text-base font-normal" %>
            <%= f.text_field :industry, class: 'p-3 transition-colors focus:text-[#333333] text-[#333333]/50 font-normal border-b border-[#BBBDD1] rounded-md' %>
        </div>

        <div class="flex flex-col gap-[2px]">
            <%= f.label :about_company, "About Company", class: "text-[#333333] text-base font-normal" %>
            <%= f.text_area :about_company, rows: 4, class: 'p-3 transition-colors focus:text-[#333333] text-[#333333]/50 font-normal border-b border-[#BBBDD1] resize-none rounded-md' %>
        </div>

        <div class="flex flex-col gap-[2px]">
            <%= f.label :office_location, "Office Location", class: "text-[#333333] text-base font-normal" %>
            <%= f.text_field :office_location, class: 'p-3 transition-colors focus:text-[#333333] text-[#333333]/50 font-normal border-b border-[#BBBDD1] rounded-md' %>
        </div>

        <div class="flex flex-col gap-[2px]">
            <%= f.label :company_email, "Email", class: "text-[#333333] text-base font-normal" %>
            <%= f.text_field :company_email, class: 'p-3 transition-colors focus:text-[#333333] text-[#333333]/50 font-normal border-b border-[#BBBDD1] rounded-md' %>
        </div>

        <div class="flex flex-col gap-[2px]">
            <%= f.label :company_website, "Website URL", class: "text-[#333333] text-base font-normal" %>
            <%= f.text_field :company_website, class: 'p-3 transition-colors focus:text-[#333333] text-[#333333]/50 font-normal border-b border-[#BBBDD1] rounded-md' %>
        </div>

        <div class="flex flex-col gap-[2px]">
        <%= f.label :employee_count, "Number of Employees", class: "text-[#333333] text-base font-normal" %>
        <%= f.select :employee_count, options_for_select(["1-50", "51-200", "201-500", "501-1000", "1001+"]),  { prompt: "Choose number of employees" }, { class: "p-3 transition-colors focus:text-[#333333] text-[#333333]/50 font-normal border-b border-[#BBBDD1] rounded-md" } %>
        </div>

        <div class="my-3">
            <%= f.submit "Save Changes", class: "w-full px-4 py-2 text-white text-lg font-medium flex items-center justify-center bg-[#1499DC] hover:bg-[#0d7bbd] cursor-pointer rounded-md" %>
        </div>
    <% end %>
</div>