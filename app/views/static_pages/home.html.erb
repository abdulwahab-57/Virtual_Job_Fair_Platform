                    <p>9 Km from Faisalabad Motorway</p>
                    <p>Interchange towards Chiniot</p>
                    <p>info.cfd@nu.edu.pk</p>
                    <p>(041) 111 128 128</p>
                </div>
            </div>
        </div>
    </div>

    <div class="border-t border-white/20">
        <div class="px-6 md:px-16 py-4 text-center text-xs text-white/80">
            © 2026 VJFP. All rights reserved.
        </div>
    </div>
</footer>