        <div class="grid gap-12 lg:grid-cols-4">
            <div class="space-y-6">
                <img src="<%= asset_path('logo') %>" alt="Fast Nuces Logo" style="height: 52px; width: auto;">
                <p class="text-sm leading-6 text-white/90">
                    Its the 5th campus of FAST-NU in the middle of Chiniot - Faisalabad. It has the honor
                    of being Pakistan's first federal chartered multi-campus University.
                </p>
                <div class="flex items-center gap-4 text-sm">
                    <a href="https://www.facebook.com/fast.cfd.official" class="hover:text-white/80" target="_blank" rel="noopener noreferrer">Facebook</a>
                    <a href="https://www.youtube.com/channel/UCFHYfI_zCA58WW9UgOFjXug" class="hover:text-white/80" target="_blank" rel="noopener noreferrer">YouTube</a>
                </div>
            </div>

            <div class="space-y-4">
                <h4 class="text-sm font-semibold tracking-wide">Information</h4>
                <div class="flex flex-col gap-2 text-sm text-white/90">
                    <%= link_to 'Home', root_path, class: 'hover:text-white' %>
                    <a href="#" class="hover:text-white">About Chiniot-Faisalabad Campus</a>
                    <a href="#" class="hover:text-white">News</a>
                    <a href="#" class="hover:text-white">Contact Us</a>
                    <a href="#" class="hover:text-white">Privacy Policy</a>
                    <a href="#" class="hover:text-white">Terms Of Use</a>
                </div>
            </div>

            <div class="space-y-4">
                <h4 class="text-sm font-semibold tracking-wide">Popular Post</h4>
                <div class="space-y-4 text-sm text-white/90">
                    <div>
                        <p class="font-semibold text-white">Gender Equity, Inclusion and Anti Harassment</p>
                        <p class="text-xs text-white/70">September 12, 2025</p>
                    </div>
                    <div>
                        <p class="font-semibold text-white">Faculty Positions</p>
                        <p class="text-xs text-white/70">April 8, 2024</p>
