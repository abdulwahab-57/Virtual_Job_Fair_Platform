            </button>

            <!-- Dropdown Menu -->
            <div id="profile-menu" class="absolute z-10 right-0 mt-2 hidden bg-white border rounded-md shadow-lg w-40">
                <%= link_to 'My Profile', @show_profile_path, class: 'block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100' %>
                <a href="/settings" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Settings</a>
                <a href="/logout" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Logout</a>
            </div>
        </div>
    </div>
