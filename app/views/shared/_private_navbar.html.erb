<nav class="px-4 py-2 bg-white shadow-sm">
    <div class="flex justify-between items-center">
        <% if local_assigns[:header_text] %>
            <h1 class="text-2xl font-semibold text-[#333333]"><%= header_text %></h1>
        <% end %>

        <!-- Profile Dropdown -->
        <div class="relative" data-controller="profile-menu">
            <!-- Profile Button -->
            <button id="profile-button" class="flex items-center focus:outline-none" data-action="click->profile-menu#toggle">
                <% if current_user.profile_picture.attached? %>
                    <%= image_tag current_user.profile_picture, 
                                alt: "Profile",
                                class: "rounded-full w-10 h-10 border border-gray-300" %>
                <% else %>
                    <img src="https://placehold.co/40x40" alt="Profile"
                        class="rounded-full w-10 h-10 border border-gray-300" />
                <% end %>
            </button>

            <!-- Dropdown Menu -->
            <div id="profile-menu" class="absolute z-10 right-0 mt-2 hidden bg-white border rounded-md shadow-lg w-40">
                <%= link_to 'My Profile', @show_profile_path, class: 'block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100' %>
                <a href="/settings" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Settings</a>
                <%= link_to 'Logout', destroy_user_session_path, method: :delete, data: { turbo_method: :delete }, class: 'block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100' %>
            </div>
        </div>
    </div>
</nav>