<div class="w-64 bg-gradient-to-b from-[#1569E0] to-[#0D4DA3] shadow-lg">
    <!-- Logo and Brand -->
    <div class="px-6 py-5 border-b border-blue-500/30">
        <div class="flex items-center">
            <!-- Logo Icon -->
            <div class="flex justify-center items-center w-10 h-10 bg-white rounded-md shadow-md">
                <span class="text-[#1569E0] font-bold text-xl">VJ</span>
            </div>
            
            <!-- Brand Name -->
            <div class="ml-3">
                <h1 class="text-xl font-bold text-white tracking-wide">VJFP</h1>
                <p class="text-xs text-blue-100 opacity-80">Virtual Job Fair Platform</p>
            </div>
        </div>
    </div>
    
    <!-- Navigation -->
    <nav class="p-4 mt-2 space-y-1">
        <% @tabs.each do |tab| %>
            <% 
               # Determine if this is the active tab
               is_active = request.path == tab[:path]
               tab_class = is_active ? 
                  'flex items-center px-4 py-3 text-white bg-white/20 rounded-md w-full truncate font-medium' : 
                  'flex items-center px-4 py-3 text-blue-100 hover:bg-white/10 rounded-md w-full truncate transition-colors duration-200'
            %>
            
            <%= link_to tab[:path], class: tab_class do %>
                <div class="flex items-center">
                    <span class="<%= is_active ? 'text-white' : 'text-blue-200' %>">
                        <%= svg_icon(tab[:icon]) %>
                    </span>
                    <span class="ml-3 truncate"><%= tab[:label] %></span>
                </div>
            <% end %>
        <% end %>
    </nav>
    
    <!-- Footer -->
    <div class="absolute bottom-0 w-64 px-6 py-4 border-t border-blue-500/30">
        <div class="flex items-center justify-between">
            <div class="text-xs text-blue-100 opacity-70">
                &copy; 2025 VJFP
            </div>
            <div class="text-xs text-blue-100 opacity-70">
                v1.0
            </div>
        </div>
    </div>
</div>
