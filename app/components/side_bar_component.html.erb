<div class="w-64 bg-gray-100 border-r">
    <div class="p-4">
        <h1 class="text-2xl font-bold text-sky-600">V</h1>
    </div>
    <nav class="mt-4 space-y-2">
        <%= link_to @home_path, class: 'flex items-center px-4 py-2 text-gray-700 hover:bg-gray-200' do %>
            <%= image_tag svg_icon('home'), class: "w-6 h-6 mr-3" %>Home
        <% end %>

        <% @tabs.each do |tab| %>
            <%= link_to tab[:path], class: 'flex items-center px-4 py-2 text-gray-700 hover:bg-gray-200' do %>
                <%= image_tag svg_icon(tab[:icon]), class: "w-6 h-6 mr-3" %><%= tab[:label] %>
            <% end %>
        <% end %>
    </nav>
</div>
