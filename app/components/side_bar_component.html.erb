<div class="min-w-64 bg-[#1499DC]">
    <div class="px-8 py-6">
        <h1 class="text-2xl font-bold text-white">VJFP</h1>
    </div>
    <nav class="p-4 mt-4 space-y-1">
        <%= link_to @home_path, class: 'sidebar-nav-item' do %>
            <%= svg_icon('home') %>
            <span>Home</span>
        <% end %>

        <% @tabs.each do |tab| %>
            <%= link_to tab[:path], class: 'sidebar-nav-item' do %>
                <%= svg_icon(tab[:icon]) %>
                <span><%= tab[:label] %></span>
            <% end %>
        <% end %>
    </nav>
</div>
