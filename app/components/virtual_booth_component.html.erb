<div class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300 overflow-hidden border border-gray-200">
  <!-- Meeting Status Badge -->
  <div class="flex justify-between items-center px-4 py-2 bg-blue-50">
    <div class="text-xs font-semibold text-blue-700 bg-blue-100 rounded-full px-3 py-1">
      <%= meeting_status %>
    </div>
    <div class="text-xs text-gray-500">ID: <%= meeting.meeting_number %></div>
  </div>
  
  <!-- Meeting Info Section -->
  <div class="p-4">
    <h3 class="text-lg font-semibold text-gray-800 mb-2" title="<%= meeting.topic %>"><%= truncated_topic %></h3>
    
    <div class="flex items-center mb-3">
      <svg class="w-4 h-4 text-gray-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <span class="text-gray-600 text-sm"><%= formatted_time %></span>
    </div>
    
    <div class="flex items-center mb-3">
      <svg class="w-4 h-4 text-gray-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <span class="text-gray-600 text-sm">Duration: <%= meeting_duration %></span>
    </div>

    <%= link_to "Join Meeting",career_officer_job_fair_arena_path(id: meeting.meeting_number, join_url: meeting.join_url), class: "block w-full bg-[#1499DC] hover:bg-[#0d7bbd] text-white font-medium py-2 px-4 rounded-md text-center transition-colors duration-300" %>
  </div>
</div>
